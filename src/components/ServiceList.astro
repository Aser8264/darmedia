---
// Cele 11 servicii ca rânduri mari, grupate în cele 4 categorii existente.
// Desktop: la hover, o formă magenta urmărește cursorul și numele se deplasează. Touch/tastatură: tap/Enter deschide rândul (details nativ).
import Arrow from './Arrow.astro';
import { services, groups } from '../data/services';
interface Props { headingLevel?: 'h2' | 'h3' }
const { headingLevel: H = 'h3' } = Astro.props;
let n = 0;
---
<div class="svc">
  {groups.map((g) => {
    const top = services.filter((s) => s.group === g.id && !s.parent);
    return (
      <section class="svc__group" aria-label={g.label}>
        <div class="svc__label">
          <H class="svc__cat">{g.label}</H>
          <p class="svc__note">{g.note}</p>
        </div>
        <ul class="svc__rows">
          {top.map((s) => {
            n += 1;
            const subs = services.filter((x) => x.parent === s.slug);
            return (
              <li>
                <details class="svc__row" data-follow>
                  <summary>
                    <span class="svc__n">{String(n).padStart(2, '0')}</span>
                    <span class="svc__name">{s.name}</span>
                    <span class="svc__plus" aria-hidden="true"></span>
                  </summary>
                  <div class="svc__body">
                    <p>{s.summary}</p>
                    {subs.length > 0 && (
                      <ul class="svc__subs" aria-label={`Platforme ${s.name}`}>{subs.map((x) => <li><a href={`/${x.slug}/`}>{x.name}</a></li>)}</ul>
                    )}
                    <a class="more" href={`/${s.slug}/`}>Despre {s.name} <Arrow /></a>
                  </div>
                  <span class="svc__fill" aria-hidden="true"></span>
                </details>
              </li>
            );
          })}
        </ul>
      </section>
    );
  })}
</div>
<style>
  .svc { display: grid; gap: clamp(2.5rem, 5vw, 4rem); }
  .svc__group { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap); }
  .svc__label { grid-column: 1 / span 3; padding-top: 1.1rem; }
  .svc__cat { font-size: var(--fs-xs); font-weight: 800; letter-spacing: 0.16em; text-transform: uppercase; color: var(--accent-text); }
  .svc__note { font-size: var(--fs-sm); color: var(--fg-2); margin-top: 0.35rem; max-width: 14rem; }
  .svc__rows { grid-column: 4 / -1; border-top: 1px solid var(--line-2); }
  .svc__rows > li { border-bottom: 1px solid var(--line-2); }
  .svc__row { position: relative; overflow: hidden; isolation: isolate; }
  .svc__row summary { display: grid; grid-template-columns: 3rem 1fr 2.5rem; align-items: center; gap: 0.75rem; min-height: clamp(4.5rem, 8vw, 6.5rem); cursor: pointer; list-style: none; }
  .svc__row summary::-webkit-details-marker { display: none; }
  .svc__n { font-weight: 750; font-size: var(--fs-sm); font-variant-numeric: tabular-nums; color: var(--fg-2); }
  .svc__name { font-size: clamp(1.75rem, 1rem + 3.4vw, 4rem); font-weight: 800; letter-spacing: -0.05em; line-height: 1; transition: transform 0.5s var(--ease-out); }
  .svc__plus { position: relative; justify-self: end; width: 2.5rem; height: 2.5rem; border: 2px solid currentColor; border-radius: 50%; transition: transform 0.4s var(--ease-out); }
  .svc__plus::before, .svc__plus::after { content: ''; position: absolute; left: 50%; top: 50%; width: 0.85rem; height: 2px; background: currentColor; transform: translate(-50%, -50%); }
  .svc__plus::after { transform: translate(-50%, -50%) rotate(90deg); }
  .svc__row[open] .svc__plus { transform: rotate(45deg); background: var(--magenta); border-color: var(--magenta); color: #fff; }
  .svc__body { display: grid; gap: 1rem; justify-items: start; padding: 0 3.25rem 2rem 3.75rem; max-width: 46rem; color: var(--fg-2); font-size: var(--fs-lg); }
  .svc__subs { display: flex; flex-wrap: wrap; gap: 0.25rem 1.5rem; }
  .svc__subs a { display: inline-flex; align-items: center; min-height: 2.5rem; font-weight: 700; color: var(--fg); border-bottom: 2px solid var(--magenta); }
  .svc__subs a:hover { color: var(--accent-text); }
  .svc__fill { position: absolute; z-index: -1; left: 0; top: 0; width: 22rem; height: 22rem; margin: -11rem 0 0 -11rem; border-radius: 50%; background: var(--magenta); opacity: 0; transform: translate(var(--mx, 50%), var(--my, 50%)) scale(0.3); transition: transform 0.25s var(--ease-out), opacity 0.3s; pointer-events: none; }
  @media (hover: hover) and (pointer: fine) {
    .svc__row:hover .svc__fill { opacity: 1; transform: translate(var(--mx, 50%), var(--my, 50%)) scale(1); }
    .svc__row:hover .svc__name { transform: translateX(1rem); }
    .svc__row:hover .svc__n, .svc__row:hover .svc__body { color: var(--fg); }
  }
  @media (max-width: 900px) {
    .svc__label, .svc__rows { grid-column: 1 / -1; }
    .svc__label { padding: 0 0 1rem; }
    .svc__row summary { grid-template-columns: 2.25rem 1fr 2.5rem; }
    .svc__body { padding: 0 0 1.5rem 0; }
  }
</style>
