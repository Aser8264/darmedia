---
// Pagina principală — direcție editorială pe grilă elvețiană: hârtie crem, cerneală prună, magenta folosit rar și intenționat.
// Tot conținutul (cifre, studii de caz, servicii, testimoniale, echipă, clienți, FAQ) vine din src/data — nimic inventat.
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import { company, partners, keyResults, stats, caseStudies, founders, clients, faq, googleReviews, testimonials } from '../data/site';
import { services, groups } from '../data/services';
import { logoSize } from '../data/logos';
import { posts, formatDate, postBySlug, coverSrcset } from '../data/posts';
import fondatori from '../assets/site/fondatori.webp';
import fDumitru from '../assets/site/f-dumitru.webp';
import fAdelina from '../assets/site/f-adelina.webp';
import fRadu from '../assets/site/f-radu.webp';

const portraits: Record<string, ImageMetadata> = { 'Dumitru Pascariu': fDumitru, 'Adelina Elena Ababei': fAdelina, 'Radu Dascălul': fRadu };
const allCases = caseStudies.filter((c) => postBySlug(c.slug));
const [lead, ...restCases] = allCases;
const leadPost = postBySlug(lead.slug)!;
const latest = posts.slice(0, 3);
const [stProjects, stBudget, stYears] = [stats[1], stats[2], stats[0]]; // 350+ · 4+ mil. € · 9+
const [quoteLead, ...quotes] = testimonials;

// Cele 4 rezultate cheie (din FAQ / keyResults) puse lângă grupele de servicii existente.
// „Conversie” nu are o grupă de servicii proprie, iar „Brand” nu are un rezultat cheie: le afișăm ca atare, fără legături inventate.
const kr = (t: string) => keyResults.find((k) => k.title === t)!;
const g = (id: string) => groups.find((x) => x.id === id)!;
const rows = [
  { title: 'Claritate', text: kr('Claritate').text, group: g('fundament') },
  { title: 'Clienți noi', text: kr('Clienți noi').text, group: g('achizitie') },
  { title: 'Conversie', text: kr('Conversie').text, group: null },
  { title: 'Retenție', text: kr('Retenție').text, group: g('retentie') },
  { title: 'Brand', text: g('brand').note, group: g('brand') },
];
const topServices = (gid: string) => services.filter((s) => s.group === gid && !s.parent);
const subs = (slug: string) => services.filter((s) => s.parent === slug);
---
<Base title="DAR Media — Agenție de digital marketing, Cluj-Napoca">

  <!-- 1. Hero: titlul pe toată măsura; fotografia fondatorilor iese din grilă până la marginea dreaptă -->
  <section class="hero" aria-labelledby="hero-h">
    <div class="wrap">
      <h1 class="hero__title lines is-anim" id="hero-h">
        <span style="--i:0"><span>Strategii de omnichannel</span></span>
        <span style="--i:1"><span>marketing care îți aduc</span></span>
        <span style="--i:2"><span>leaduri și vânzări <em>profitabile.</em></span></span>
      </h1>
    </div>
    <div class="hero__body">
      <div class="hero__copy">
        <p class="hero__sub">Agenție de digital marketing din Cluj-Napoca, din {company.since}. Sprijinim afacerile aflate în faza de creștere &amp; scalare să genereze vânzări profitabile, clienți mulțumiți și impact pe termen lung.</p>
        <div class="hero__actions">
          <a class="btn" href="/audit-gratuit/">Cere un audit gratuit <Arrow /></a>
          <a class="hero__link" href="#rezultate">Vezi rezultatele</a>
        </div>
        <dl class="hero__facts">
          <div><dt>Proiecte</dt><dd>350+</dd></div>
          <div><dt>Bugete gestionate</dt><dd>4+ mil.&nbsp;€</dd></div>
          <div><dt>Ani de experiență</dt><dd>9+</dd></div>
        </dl>
      </div>
      <figure class="hero__photo">
        <div class="hero__frame">
          <Picture src={fondatori} formats={['avif', 'webp']} fallbackFormat="webp" widths={[640, 960, 1280, 1600]} sizes="(max-width: 900px) 100vw, 60vw" quality={82} alt="Dumitru, Adelina și Radu, fondatorii DAR Media, cu mâinile unite" loading="eager" fetchpriority="high" decoding="async" />
        </div>
        <figcaption><span><b>D</b>umitru, <b>A</b>delina, <b>R</b>adu</span> — fondatorii DAR Media</figcaption>
      </figure>
    </div>
  </section>

  <!-- 2. Credențiale: un singur rând static, cu ratingul Google alături -->
  <section class="creds" aria-labelledby="creds-h">
    <div class="wrap creds__in">
      <h2 class="creds__h" id="creds-h">Parteneri și certificări</h2>
      <ul class="creds__logos">
        {partners.map((p) => {
          const s = logoSize[p.logo];
          const img = <img src={`/media/logos/${p.logo}.webp`} alt={p.name} width={s.w} height={s.h} loading="lazy" decoding="async" />;
          return <li>{p.href ? <a href={p.href} target="_blank" rel="noopener noreferrer">{img}<span class="sr-only"> (se deschide într-o filă nouă)</span></a> : img}</li>;
        })}
      </ul>
      <p class="creds__rating"><strong>{googleReviews.rating}</strong> pe Google · {googleReviews.count} de recenzii</p>
    </div>
  </section>

  <!-- 3. Rezultate: un studiu de caz principal, apoi un index editorial cu toate celelalte -->
  <section class="section results" id="rezultate" aria-labelledby="cases-h">
    <div class="wrap">
      <header class="results__head" data-reveal>
        <h2 class="h2" id="cases-h">Rezultate concrete, nu promisiuni.</h2>
        <p class="results__intro">Cum am generat, concret, rezultate pentru clienții DAR Media. Oferim și alte exemple relevante în call, în funcție de industrie.</p>
      </header>

      <a class="lead-case" href={`/${lead.slug}/`} data-reveal>
        <span class="lead-case__fig"><span class="lead-case__num">{lead.figure}</span> <span class="lead-case__unit">{lead.unit}</span></span>
        <span class="lead-case__text">
          <span class="lead-case__line">{lead.line}</span>
          <span class="lead-case__meta">{lead.channel} · {formatDate(leadPost.date)}</span>
          <span class="lead-case__more">Citește studiul de caz <Arrow /></span>
        </span>
        {leadPost.cover && (
          <span class="lead-case__img"><img src={leadPost.cover.src} width={leadPost.cover.width} height={leadPost.cover.height} srcset={coverSrcset(leadPost.cover)} sizes="(max-width: 900px) 90vw, 30vw" alt="" loading="lazy" decoding="async" /></span>
        )}
      </a>

      <ol class="case-index" data-stagger>
        {restCases.map((c) => {
          const p = postBySlug(c.slug)!;
          return (
            <li>
              <a href={`/${c.slug}/`}>
                <span class="ci__fig"><span class="ci__num">{c.figure}</span>{c.unit && <> <span class="ci__unit">{c.unit}</span></>}</span>
                <span class="ci__line">{c.line}</span>
                <span class="ci__meta"><span>{c.channel}</span><time datetime={p.date}>{formatDate(p.date)}</time></span>
                <span class="ci__go" aria-hidden="true"><Arrow /></span>
              </a>
            </li>
          );
        })}
      </ol>
      <p class="results__all"><a class="more" href="/studii-de-caz/">Toate studiile de caz <Arrow /></a></p>
    </div>
  </section>

  <!-- 4. Servicii, puse lângă rezultatul de business pe care îl susțin -->
  <section class="section services" id="servicii" aria-labelledby="svc-h">
    <div class="wrap">
      <header class="services__head" data-reveal>
        <h2 class="h2" id="svc-h">Servicii de marketing digital, focusate pe rezultate concrete.</h2>
        <p class="services__intro">Soluțiile noastre te susțin să obții 4 rezultate cheie.</p>
      </header>
      <div class="map">
        <div class="map__row map__row--head" aria-hidden="true">
          <span>Rezultat</span>
          <span>Ce înseamnă</span>
          <span>Servicii</span>
        </div>
        {rows.map((r) => (
          <div class="map__row" data-reveal>
            <h3 class="map__title">{r.title}</h3>
            <p class="map__text">{r.text}</p>
            <div class="map__svc">
              {r.group ? (
                <ul>
                  {topServices(r.group.id).map((s) => (
                    <li>
                      <a href={`/${s.slug}/`}><span class="map__name">{s.name}</span><Arrow /></a>
                      <p>{s.summary}</p>
                      {subs(s.slug).length > 0 && (
                        <p class="map__subs">{subs(s.slug).map((x, i) => <>{i > 0 && ' · '}<a href={`/${x.slug}/`}>{x.name}</a></>)}</p>
                      )}
                    </li>
                  ))}
                </ul>
              ) : (
                <p class="map__note">Optimizarea ratei de conversie pe multiple platforme eCommerce (Gomag, Shopify, WooCommerce etc.).</p>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. Cifre: compoziție tipografică pe prună -->
  <section class="section numbers t-plum" aria-labelledby="num-h">
    <div class="wrap numbers__in">
      <h2 class="numbers__h" id="num-h" data-reveal>Suntem mereu pregătiți pentru o nouă provocare.</h2>
      <div class="numbers__big" data-reveal>
        <p class="numbers__val numbers__val--xl"><span data-count="350">350</span>+</p>
        <p class="numbers__label">{stProjects.label}</p>
        <p class="numbers__note">{stProjects.note}</p>
      </div>
      <div class="numbers__side">
        <div data-reveal>
          <p class="numbers__val"><span data-count="4">4</span>+ <span class="numbers__unit">mil.&nbsp;€</span></p>
          <p class="numbers__label">{stBudget.label}</p>
          <p class="numbers__note">{stBudget.note}</p>
        </div>
        <div data-reveal>
          <p class="numbers__val"><span data-count="9">9</span>+</p>
          <p class="numbers__label">{stYears.label}</p>
          <p class="numbers__note">{stYears.note}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. Testimoniale: un citat principal, apoi toate celelalte, integral -->
  <section class="section voices" aria-labelledby="tst-h">
    <div class="wrap">
      <h2 class="h2 voices__h" id="tst-h" data-reveal>Ce spun clienții noștri</h2>
      <figure class="voices__lead" data-reveal>
        <blockquote>
          <p class="voices__pull">„{quoteLead.quote[0]}”</p>
          <div class="voices__rest">{quoteLead.quote.slice(1).map((q) => <p>{q}</p>)}</div>
        </blockquote>
        <figcaption><strong>{quoteLead.name}</strong><span>{quoteLead.role}</span></figcaption>
      </figure>
      <div class="voices__grid">
        {quotes.map((t) => (
          <figure class="voice" data-reveal>
            <blockquote>{t.quote.map((q, i) => <p class:list={{ voice__first: i === 0 }}>{q}</p>)}</blockquote>
            <figcaption><strong>{t.name}</strong><span>{t.role}</span></figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- 7. Fondatorii: portrete decupate pe aceeași linie de bază, cu inițialele care formează numele -->
  <section class="section founders t-pink" aria-labelledby="team-h">
    <div class="wrap founders__in">
      <div class="founders__text" data-reveal>
        <h2 class="h2" id="team-h">Echipa ta creativă de marketing, care îți aduce rezultate măsurate.</h2>
        <p class="founders__lead">Numele a apărut de la inițialele prenumelor noastre — Dumitru, Adelina, Radu — și de la ideea că orice om și orice business are un dar prețios de oferit celorlalți.</p>
        <p class="muted">Credem cu tărie în forța echipei noastre, formată din colegi tineri, creativi și orientați spre rezultate. Atuurile noastre sunt comunicarea, transparența, evoluția continuă și relațiile solide construite între noi.</p>
        <p class="founders__links"><a class="more" href="/echipa-darmedia/">Vezi echipa <Arrow /></a><a class="more" href="/povestea-noastra/">Povestea noastră <Arrow /></a></p>
      </div>
      <ul class="founders__row" data-stagger>
        {founders.map((f) => (
          <li class="founder">
            <p class="founder__initial" aria-hidden="true">{f.initial}</p>
            <div class="founder__pic">
              <Picture src={portraits[f.name]} formats={['avif', 'webp']} fallbackFormat="webp" widths={[300, 450]} sizes="(max-width: 640px) 33vw, 18vw" alt={f.name} loading="lazy" decoding="async" />
            </div>
            <h3 class="founder__name">{f.name}</h3>
            <p class="founder__role">{f.role}</p>
            <a class="link founder__in" href={f.links.LinkedIn} target="_blank" rel="noopener noreferrer">LinkedIn<span class="sr-only"> — {f.name} (se deschide într-o filă nouă)</span></a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 8. Clienți: grilă statică, toate brandurile -->
  <section class="section clients" aria-labelledby="cl-h">
    <div class="wrap">
      <header class="clients__head" data-reveal>
        <h2 class="h2" id="cl-h">Afaceri care au ales DAR&nbsp;Media.</h2>
        <a class="more" href="/portofoliu/">Portofoliu · {clients.length} branduri <Arrow /></a>
      </header>
      <ul class="clients__grid" aria-label={`Logourile celor ${clients.length} de clienți DAR Media`}>
        {clients.map((c) => {
          const s = logoSize[c.logo] ?? { w: 120, h: 40 };
          return <li><img src={`/media/logos/${c.logo}.webp`} alt={c.name} width={s.w} height={s.h} loading="lazy" decoding="async" /></li>;
        })}
      </ul>
    </div>
  </section>

  <!-- 9. FAQ -->
  <section class="section faqs" aria-labelledby="faq-h">
    <div class="wrap"><div class="faqs__in">
      <div class="faqs__head" data-reveal>
        <h2 class="h2" id="faq-h">Răspunsuri directe, înainte de primul call.</h2>
        <p class="muted">Nu ai găsit răspunsul? <a class="link" href="/contact/">Scrie-ne</a> sau <a class="link" href={company.calendly} target="_blank" rel="noopener noreferrer">programează o discuție</a>.</p>
      </div>
      <div class="faqs__list"><Faq items={faq} /></div>
    </div></div>
  </section>

  <!-- 10. Resurse -->
  <section class="section learn" aria-labelledby="learn-h">
    <div class="wrap"><div class="learn__in">
      <div class="learn__head" data-reveal>
        <h2 class="h2" id="learn-h">Afacerea ta crește prin educație continuă de marketing &amp; business.</h2>
        <p class="muted">Învață să te promovezi mai eficient, la un cost mai mic.</p>
        <ul class="learn__links">
          <li><a class="more" href="/ebook/">Ebook-uri gratuite <Arrow /></a></li>
          <li><a class="more" href="/blog/">Blog <Arrow /></a></li>
          <li><a class="more" href={company.social[3].href} target="_blank" rel="noopener noreferrer">Video<span class="sr-only"> (YouTube, se deschide într-o filă nouă)</span> <Arrow dir="up-right" /></a></li>
        </ul>
      </div>
      <ul class="learn__posts" data-stagger>
        {latest.map((p) => (
          <li>
            <a href={`/${p.slug}/`}>
              <span class="learn__img">{p.cover && <img src={p.cover.src} width={p.cover.width} height={p.cover.height} srcset={coverSrcset(p.cover)} sizes="(max-width: 900px) 30vw, 10rem" alt="" loading="lazy" decoding="async" />}</span>
              <span class="learn__meta">{p.categories[0]} · {formatDate(p.date)}</span>
              <span class="learn__title">{p.title}</span>
            </a>
          </li>
        ))}
      </ul>
    </div></div>
  </section>

  <Cta />
</Base>

<style>
  /* ============ 1. HERO ============ */
  .hero { padding-top: clamp(2.5rem, 6vw, 5rem); }
  .hero__title { font-size: clamp(2.25rem, 1rem + 5vw, 5.75rem); font-weight: 700; line-height: 1.02; letter-spacing: -0.04em; }
  .hero__title em { font-family: var(--serif); font-style: italic; font-weight: 400; letter-spacing: -0.015em; color: var(--mark); padding-right: 0.05em; }
  /* textul stă pe grilă; fotografia iese din grilă până la marginea ecranului */
  .hero__body { display: grid; grid-template-columns: minmax(var(--gutter), 1fr) minmax(0, calc(var(--max) - 2 * var(--gutter))) minmax(var(--gutter), 1fr); margin-top: clamp(2.5rem, 5vw, 4rem); }
  .hero__body > * { grid-row: 1; }
  .hero__copy { grid-column: 2; width: min(100%, 23rem); display: grid; gap: 1.75rem; align-content: start; }
  .hero__sub { font-size: var(--fs-lg); line-height: 1.5; color: var(--fg-2); }
  .hero__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1.5rem; }
  .hero__link { display: inline-flex; align-items: center; min-height: 2.75rem; font-weight: 650; background: linear-gradient(currentColor, currentColor) 0 calc(100% - 0.6rem) / 100% 1px no-repeat; transition: background-size 0.35s var(--ease-out), color 0.15s ease; }
  .hero__facts { display: grid; border-top: 1px solid var(--line-2); }
  .hero__facts > div { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; padding-block: 0.7rem; border-bottom: 1px solid var(--line); }
  .hero__facts dt { font-size: var(--fs-sm); color: var(--fg-2); }
  .hero__facts dd { font-size: 1.5rem; font-weight: 700; letter-spacing: -0.03em; font-variant-numeric: lining-nums; }
  .hero__photo { grid-column: 2 / -1; justify-self: end; width: calc(100% - 26.5rem); min-width: 0; }
  .hero__frame { overflow: hidden; background: #e7e3e4; }
  .hero__frame :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 1600 / 1093; }
  .js .hero__frame :global(img) { animation: settle 1.6s var(--ease-out) 0.1s both; }
  @keyframes settle { from { transform: scale(1.06); } to { transform: scale(1); } }
  .hero__photo figcaption { padding-top: 0.75rem; font-size: var(--fs-sm); color: var(--fg-2); }
  .hero__photo figcaption b { color: var(--mark); font-weight: 700; }
  @media (hover: hover) and (pointer: fine) { .hero__link:hover { color: var(--mark); background-size: 0 1px; background-position: 100% calc(100% - 0.6rem); } }

  /* ============ 2. CREDENȚIALE ============ */
  .creds { margin-top: clamp(3rem, 6vw, 5rem); border-block: 1px solid var(--line-2); }
  .creds__in { display: grid; grid-template-columns: 9rem minmax(0, 1fr) auto; align-items: center; gap: 1.25rem 2rem; padding-block: 1.4rem; }
  .creds__h { font-size: var(--fs-sm); font-weight: 600; color: var(--fg-2); line-height: 1.3; }
  .creds__logos { display: grid; grid-template-columns: repeat(8, minmax(0, 1fr)); align-items: center; gap: 1rem 1.5rem; }
  .creds__logos li { display: grid; place-items: center; min-height: 2.75rem; }
  .creds__logos a { display: block; }
  .creds__logos img { height: auto; max-height: 2.1rem; max-width: 100%; width: auto; filter: brightness(0); opacity: 0.72; transition: opacity 0.2s ease; }
  .creds__rating { font-size: var(--fs-sm); color: var(--fg-2); white-space: nowrap; padding-left: 2rem; border-left: 1px solid var(--line); }
  .creds__rating strong { color: var(--fg); }
  @media (hover: hover) and (pointer: fine) { .creds__logos li:hover img { opacity: 1; } }

  /* ============ 3. REZULTATE ============ */
  .results__head, .services__head { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap); row-gap: 1rem; align-items: end; margin-bottom: clamp(2.5rem, 5vw, 4rem); }
  .results__head .h2, .services__head .h2 { grid-column: 1 / span 7; }
  .results__intro, .services__intro { grid-column: 9 / -1; color: var(--fg-2); }

  .lead-case { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap); row-gap: 1.5rem; align-items: end; padding-block: 2rem 2.5rem; border-top: 2px solid var(--fg); }
  .lead-case__fig { grid-column: 1 / -1; display: block; line-height: 0.9; font-variant-numeric: lining-nums; }
  .lead-case__num { font-size: clamp(4.25rem, 1.8rem + 11vw, 11.5rem); font-weight: 700; letter-spacing: -0.05em; transition: color 0.3s ease; }
  .lead-case__unit { margin-left: 0.25em; font-size: clamp(1.5rem, 1rem + 2vw, 3rem); font-weight: 600; letter-spacing: 0; color: var(--mark); }
  .lead-case__text { grid-column: 1 / span 6; display: grid; gap: 0.6rem; justify-items: start; }
  .lead-case__line { font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.6rem); font-weight: 550; line-height: 1.35; letter-spacing: -0.015em; max-width: 26em; }
  .lead-case__meta { font-size: var(--fs-sm); color: var(--fg-2); }
  .lead-case__more { display: inline-flex; align-items: center; gap: 0.5rem; min-height: 2.75rem; font-weight: 650; }
  .lead-case__more :global(.arrow) { color: var(--mark); transition: transform 0.25s var(--ease-out); }
  .lead-case__img { grid-column: 9 / -1; display: block; overflow: hidden; }
  .lead-case__img img { display: block; width: 100%; height: auto; transition: transform 0.7s var(--ease-out); }
  @media (hover: hover) and (pointer: fine) {
    .lead-case:hover .lead-case__num { color: var(--mark); }
    .lead-case:hover .lead-case__more :global(.arrow) { transform: translateX(4px); }
    .lead-case:hover .lead-case__img img { transform: scale(1.04); }
  }

  .case-index { border-top: 1px solid var(--line-2); }
  .case-index li { border-bottom: 1px solid var(--line); }
  .case-index a { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 5fr) minmax(0, 2fr) 2rem; gap: 0.75rem var(--gap); align-items: baseline; padding: 1.5rem 0.25rem; transition: background-color 0.25s ease, padding 0.35s var(--ease-out); }
  .ci__fig { font-variant-numeric: lining-nums; white-space: nowrap; }
  .ci__num { font-size: clamp(2.25rem, 1.6rem + 2.2vw, 3.5rem); font-weight: 700; letter-spacing: -0.04em; line-height: 1; }
  .ci__unit { margin-left: 0.3em; font-size: clamp(1rem, 0.9rem + 0.4vw, 1.25rem); font-weight: 600; color: var(--mark); }
  .ci__line { font-size: var(--fs-lg); line-height: 1.4; }
  .ci__meta { display: grid; font-size: var(--fs-sm); color: var(--fg-2); line-height: 1.5; }
