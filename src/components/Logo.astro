---
import Mark from './Mark.astro';
interface Props { size?: number }
const { size = 32 } = Astro.props;
---
<span class="logo">
  <Mark size={size} class="logo__mark" />
  <span class="logo__word">dar<span>media</span></span>
</span>
<style>
  .logo { display: inline-flex; align-items: center; gap: 0.55rem; color: var(--text); }
  .logo :global(.logo__mark) { color: var(--accent); transition: transform 0.6s var(--ease); }
  .logo:hover :global(.logo__mark) { transform: rotate(-8deg); }
  .logo__word { font-family: var(--sans); font-weight: 750; font-size: 1.3rem; letter-spacing: -0.045em; line-height: 1; }
  .logo__word span { font-weight: 400; margin-left: 0.14em; }
</style>
