---
import Arrow from './Arrow.astro';
import { company } from '../data/site';
interface Props { title?: string; text?: string }
const { title = 'Ce zici, ne apucăm <em>de treabă?</em>', text = 'Spune-ne care e principala ta provocare în online acum. Noi îți vom oferi apoi claritatea de care ai nevoie ca să o depășești.' } = Astro.props;
---
<section class="cta t-magenta" aria-labelledby="cta-h">
  <div class="wrap cta__in">
    <h2 class="cta__title" id="cta-h" set:html={title} data-reveal />
    <div class="cta__row">
      <p class="cta__text">{text}</p>
      <div class="cta__actions">
        <a class="btn" href="/audit-gratuit/">Cere un audit gratuit <Arrow /></a>
        <a class="cta__link" href="/contact/">Contactează-ne <Arrow /></a>
      </div>
      <dl class="cta__direct">
        <div><dt>Email</dt><dd><a href={`mailto:${company.email}`}>{company.email}</a></dd></div>
        <div><dt>Telefon</dt><dd><a href={company.phoneHref}>{company.phone}</a></dd></div>
      </dl>
    </div>
  </div>
</section>
<style>
  .cta { padding-block: clamp(4.5rem, 9vw, 7.5rem) clamp(3.5rem, 6vw, 5rem); }
  .cta__in { display: grid; gap: clamp(2.5rem, 5vw, 4.5rem); }
  .cta__title { font-size: clamp(2.75rem, 1.4rem + 5.4vw, 6rem); font-weight: 700; line-height: 1; letter-spacing: -0.04em; max-width: 13ch; text-wrap: balance; }
  .cta__title :global(em) { font-family: var(--serif); font-style: italic; font-weight: 400; letter-spacing: -0.015em; }
  .cta__row { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 2rem var(--gap); align-items: end; padding-top: 1.5rem; border-top: 1px solid rgba(255, 255, 255, 0.45); }
  .cta__text { grid-column: 1 / span 4; font-size: var(--fs-lg); line-height: 1.5; }
  .cta__actions { grid-column: 6 / span 3; display: grid; gap: 0.75rem; justify-items: start; }
  .cta__link { display: inline-flex; align-items: center; gap: 0.5rem; min-height: 2.75rem; font-weight: 650; }
  .cta__link :global(.arrow) { transition: transform 0.2s var(--ease-out); }
  .cta__direct { grid-column: 10 / -1; display: grid; gap: 1rem; }
  .cta__direct dt { font-size: var(--fs-xs); }
  .cta__direct dd { font-size: var(--fs-lg); font-weight: 650; letter-spacing: -0.01em; }
  .cta__direct a { display: inline-flex; min-height: 2.25rem; align-items: center; background: linear-gradient(#fff, #fff) 0 100% / 100% 1px no-repeat; transition: background-size 0.35s var(--ease-out); }
  @media (hover: hover) and (pointer: fine) {
    .cta__direct a:hover { background-size: 0 1px; background-position: 100% 100%; }
    .cta__link:hover :global(.arrow) { transform: translateX(3px); }
  }
  @media (max-width: 900px) {
    .cta__text, .cta__actions, .cta__direct { grid-column: 1 / -1; }
    .cta__actions { grid-template-columns: 1fr; justify-items: stretch; }
  }
</style>
