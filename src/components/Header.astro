---
import Logo from './Logo.astro';
import Arrow from './Arrow.astro';
import Icon from './Icon.astro';
import { nav, aboutNav, company } from '../data/site';
import { services, groups } from '../data/services';
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href));
const groupIcon = { fundament: 'compass', achizitie: 'magnet', retentie: 'repeat', brand: 'spark' } as const;
---
<header class="hdr" data-header>
  <div class="wrap hdr__in">
    <a href="/" class="hdr__logo"><Logo /><span class="sr-only"> — acasă</span></a>
    <nav class="hdr__nav" aria-label="Navigație principală">
      <ul>
        {nav.map((n) => (
          <li>
            {n.href === '/servicii/' ? (
              <button type="button" class:list={['hdr__link', { 'is-active': isActive(n.href) }]} aria-expanded="false" aria-controls="mega" data-mega-toggle>
                {n.label}<svg viewBox="0 0 10 6" width="10" height="6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
              </button>
            ) : (
              <a href={n.href} class:list={['hdr__link', { 'is-active': isActive(n.href) }]} aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a>
            )}
          </li>
        ))}
      </ul>
    </nav>
    <div class="hdr__end">
      <a href={company.english} class="hdr__lang" hreflang="en" lang="en"><span aria-hidden="true">EN</span><span class="sr-only">English version</span></a>
      <a href="/contact/" class="hdr__contact">Contact</a>
      <a href="/audit-gratuit/" class="btn btn--sm hdr__cta">Audit gratuit</a>
      <button type="button" class="hdr__burger" aria-expanded="false" aria-controls="menu" data-menu-toggle>
        <span class="sr-only">Meniu</span><i></i><i></i>
      </button>
    </div>
  </div>

  <div class="mega" id="mega" hidden data-mega>
    <div class="wrap mega__in">
      <div class="mega__intro">
        <p class="h4">Servicii de marketing digital, focusate pe rezultate concrete.</p>
        <a href="/servicii/" class="more">Toate serviciile <Arrow /></a>
      </div>
      {groups.map((g) => (
        <div class="mega__col">
          <p class="mega__label"><span class="icon-badge"><Icon name={groupIcon[g.id]} /></span><span><strong>{g.label}</strong><small>{g.note}</small></span></p>
          <ul>
            {services.filter((s) => s.group === g.id).map((s) => (
              <li class:list={{ sub: !!s.parent }}><a href={`/${s.slug}/`}>{s.name}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</header>

<div class="menu" id="menu" hidden data-menu>
  <div class="wrap menu__in">
    <nav aria-label="Meniu mobil">
      <ul class="menu__main">
        <li><a href="/">Acasă</a></li>
        {nav.map((n) => <li><a href={n.href} aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a></li>)}
        <li><a href="/contact/">Contact</a></li>
      </ul>
      <ul class="menu__sub">
        {aboutNav.slice(1).map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        <li><a href={company.english} hreflang="en" lang="en">English</a></li>
      </ul>
    </nav>
    <div class="menu__foot">
      <a href="/audit-gratuit/" class="btn">Cere un audit gratuit <Arrow /></a>
      <a href={`mailto:${company.email}`}>{company.email}</a>
      <a href={company.phoneHref}>{company.phone}</a>
    </div>
  </div>
</div>

<style>
  .hdr { position: sticky; top: 0; z-index: 50; background: rgba(11, 10, 12, 0.82); -webkit-backdrop-filter: saturate(140%) blur(14px); backdrop-filter: saturate(140%) blur(14px); border-bottom: 1px solid transparent; transition: border-color var(--dur) var(--ease); }
  .hdr.is-scrolled { border-bottom-color: var(--line); }
  .hdr__in { display: flex; align-items: center; justify-content: space-between; height: var(--header-h); gap: 1.5rem; }
  .hdr__logo { flex: none; display: inline-flex; align-items: center; min-height: 2.75rem; }
  .hdr__nav ul { display: flex; gap: clamp(0.25rem, 1vw, 0.75rem); }
  .hdr__link { position: relative; display: inline-flex; align-items: center; gap: 0.4rem; min-height: 2.75rem; background: none; border: 0; padding: 0 0.6rem; cursor: pointer; font-size: 0.9375rem; font-weight: 600; color: var(--text-2); border-radius: var(--r-sm); transition: color var(--dur) var(--ease), background-color var(--dur) var(--ease); }
  .hdr__link:hover, .hdr__link[aria-expanded='true'] { color: var(--text); background: rgba(255, 255, 255, 0.05); }
  .hdr__link.is-active { color: var(--text); }
  .hdr__link.is-active::after { content: ''; position: absolute; left: 0.6rem; right: 0.6rem; bottom: 0.35rem; height: 2px; border-radius: 2px; background: var(--accent); }
  .hdr__link svg { transition: transform var(--dur) var(--ease); }
  .hdr__link[aria-expanded='true'] svg { transform: rotate(180deg); }
  .hdr__end { display: flex; align-items: center; gap: 0.5rem; }
  .hdr__lang, .hdr__contact { display: inline-flex; align-items: center; min-height: 2.75rem; padding: 0 0.6rem; font-size: 0.875rem; font-weight: 700; color: var(--text-2); border-radius: var(--r-sm); }
  .hdr__lang { letter-spacing: 0.08em; }
  .hdr__lang:hover, .hdr__contact:hover { color: var(--text); }
  .hdr__cta { box-shadow: none; margin-left: 0.25rem; }
  .hdr__burger { display: none; width: 2.75rem; height: 2.75rem; background: none; border: 1px solid var(--line-2); border-radius: var(--r-pill); padding: 0; cursor: pointer; position: relative; }
  .hdr__burger i { position: absolute; left: 0.8rem; right: 0.8rem; height: 1.75px; background: currentColor; border-radius: 2px; transition: transform var(--dur) var(--ease); }
  .hdr__burger i:nth-of-type(1) { top: 1.05rem; }
  .hdr__burger i:nth-of-type(2) { top: 1.5rem; }
  .hdr__burger[aria-expanded='true'] i:nth-of-type(1) { transform: translateY(0.225rem) rotate(45deg); }
  .hdr__burger[aria-expanded='true'] i:nth-of-type(2) { transform: translateY(-0.225rem) rotate(-45deg); }

  .mega { position: absolute; left: 0; right: 0; top: 100%; background: var(--bg-2); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); box-shadow: 0 40px 80px -30px rgba(0, 0, 0, 0.8); }
  .mega__in { display: grid; grid-template-columns: 1.3fr repeat(4, 1fr); gap: var(--gap); padding-block: 2.25rem 2.5rem; }
  .mega__intro { display: flex; flex-direction: column; justify-content: space-between; gap: 1.5rem; padding-right: 1.5rem; }
  .mega__label { display: flex; gap: 0.75rem; align-items: center; margin-bottom: 0.9rem; }
  .mega__label .icon-badge { width: 2.5rem; height: 2.5rem; }
  .mega__label strong { display: block; font-size: 1rem; }
  .mega__label small { display: block; font-size: 0.8125rem; color: var(--text-2); line-height: 1.3; }
  .mega__col li a { display: flex; align-items: center; min-height: 2.25rem; font-size: 0.9375rem; color: var(--text); transition: color var(--dur); }
  .mega__col li.sub a { padding-left: 1rem; color: var(--text-2); font-size: 0.875rem; min-height: 2rem; }
  .mega__col li a:hover { color: var(--accent-text); }

  .menu { position: fixed; inset: 0; z-index: 40; padding-top: var(--header-h); overflow-y: auto; background: var(--bg); }
  .menu__in { display: flex; flex-direction: column; justify-content: space-between; min-height: 100%; padding-block: 1.5rem 2rem; gap: 2rem; }
  .menu__main a { display: flex; align-items: center; min-height: 3.25rem; font-size: clamp(1.75rem, 7vw, 2.5rem); font-weight: 750; letter-spacing: -0.035em; border-bottom: 1px solid var(--line); }
  .menu__main a:hover, .menu__main a[aria-current='page'] { color: var(--accent-text); }
  .menu__sub { display: flex; flex-wrap: wrap; gap: 0 1.25rem; margin-top: 1.25rem; font-size: 1rem; color: var(--text-2); }
  .menu__sub a { display: inline-flex; align-items: center; min-height: 2.75rem; }
  .menu__foot { display: grid; gap: 0.25rem; font-size: 1.0625rem; }
  .menu__foot .btn { margin-bottom: 1rem; }
  .menu__foot a:not(.btn) { display: inline-flex; align-items: center; min-height: 2.75rem; }

  @media (max-width: 1100px) {
    .hdr__nav, .hdr__lang, .hdr__contact, .mega { display: none !important; }
    .hdr__burger { display: block; }
  }
  @media (max-width: 480px) { .hdr__cta { display: none; } }
  @media (min-width: 1101px) { .menu { display: none !important; } }
  :global(body.menu-open) { overflow: hidden; }
</style>
