---
import Arrow from './Arrow.astro';
import Icon from './Icon.astro';
import { company } from '../data/site';
interface Props { title?: string; text?: string }
const { title = 'Ce zici, ne apucăm <em>de treabă?</em>', text = 'Spune-ne care e principala ta provocare în online acum. Noi îți vom oferi apoi claritatea de care ai nevoie ca să o depășești.' } = Astro.props;
---
<section class="cta" aria-labelledby="cta-h">
  <div class="wrap">
    <div class="cta__panel">
      <div class="cta__main" data-reveal>
        <p class="eyebrow">Contact</p>
        <h2 class="h1" id="cta-h" set:html={title} />
        <p class="lead">{text}</p>
      </div>
      <div class="cta__side" data-reveal style="--d:100ms">
        <div class="cta__actions">
          <a class="btn" href="/audit-gratuit/">Cere un audit gratuit <Arrow /></a>
          <a class="btn btn--ghost" href="/contact/">Contactează-ne</a>
        </div>
        <ul class="cta__direct">
          <li><Icon name="mail" /><a class="link" href={`mailto:${company.email}`}>{company.email}</a></li>
          <li><Icon name="phone" /><a class="link" href={company.phoneHref}>{company.phone}</a></li>
        </ul>
      </div>
    </div>
  </div>
</section>
<style>
  .cta { padding-block: var(--section); }
  .cta__panel { position: relative; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 2rem var(--gap); align-items: end; padding: clamp(1.75rem, 5vw, 4.5rem); border-radius: calc(var(--r-lg) + 6px); background: radial-gradient(120% 140% at 100% 0%, rgba(237, 30, 121, 0.32), transparent 55%), radial-gradient(90% 120% at 0% 100%, rgba(158, 0, 93, 0.35), transparent 60%), var(--surface); border: 1px solid rgba(237, 30, 121, 0.3); overflow: hidden; }
  .cta__main { grid-column: 1 / span 7; display: grid; gap: 1.25rem; }
  .cta__main .lead { color: #d9d2d7; }
  .cta__side { grid-column: 9 / -1; display: grid; gap: 1.75rem; }
  .cta__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .cta__direct { display: grid; gap: 0.6rem; padding-top: 1.5rem; border-top: 1px solid var(--line-2); }
  .cta__direct li { display: flex; align-items: center; gap: 0.75rem; font-size: 1.0625rem; min-height: 2.5rem; }
  .cta__direct :global(.icon) { color: var(--accent-text); }
  @media (max-width: 900px) {
    .cta__main, .cta__side { grid-column: 1 / -1; }
    .cta__actions .btn { flex: 1 1 100%; }
  }
</style>
