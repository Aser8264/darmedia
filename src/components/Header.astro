---
import Logo from './Logo.astro';
import Arrow from './Arrow.astro';
import Icon from './Icon.astro';
import { nav, aboutNav, company } from '../data/site';
import { services, groups } from '../data/services';
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href));
const groupIcon = { fundament: 'compass', achizitie: 'magnet', retentie: 'repeat', brand: 'spark' } as const;
---
<header class="hdr t-plum" data-header data-lock>
  <div class="wrap hdr__in">
    <a href="/" class="hdr__logo"><Logo /><span class="sr-only"> — acasă</span></a>
    <nav class="hdr__nav" aria-label="Navigație principală">
      <ul>
        {nav.map((n) => (
          <li>
            {n.href === '/servicii/' ? (
              <button type="button" class:list={['hdr__link', { 'is-active': isActive(n.href) }]} aria-expanded="false" aria-controls="mega" data-mega-toggle>
                {n.label}<svg viewBox="0 0 10 6" width="10" height="6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
              </button>
            ) : (
              <a href={n.href} class:list={['hdr__link', { 'is-active': isActive(n.href) }]} aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a>
            )}
          </li>
        ))}
      </ul>
    </nav>
    <div class="hdr__end">
      <a href={company.english} class="hdr__lang" hreflang="en" lang="en"><span aria-hidden="true">EN</span><span class="sr-only">English version</span></a>
      <a href="/contact/" class="hdr__contact">Contact</a>
      <a href="/audit-gratuit/" class="btn btn--sm hdr__cta" data-magnetic>Audit gratuit</a>
      <button type="button" class="hdr__burger" aria-expanded="false" aria-controls="menu" data-menu-toggle>
        <span class="sr-only">Meniu</span><i></i><i></i>
      </button>
    </div>
  </div>

  <div class="mega" id="mega" hidden data-mega>
    <div class="wrap mega__in">
      <div class="mega__intro">
        <p class="h4">Servicii de marketing digital, focusate pe rezultate concrete.</p>
        <a href="/servicii/" class="more">Toate serviciile <Arrow /></a>
      </div>
      {groups.map((g) => (
        <div class="mega__col">
          <p class="mega__label"><span class="icon-badge"><Icon name={groupIcon[g.id]} /></span><span><strong>{g.label}</strong><small>{g.note}</small></span></p>
          <ul>
            {services.filter((s) => s.group === g.id).map((s) => (
              <li class:list={{ sub: !!s.parent }}><a href={`/${s.slug}/`}>{s.name}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</header>

<div class="menu t-magenta" id="menu" hidden data-menu>
  <div class="wrap menu__in">
    <nav aria-label="Meniu mobil">
      <ul class="menu__main">
        <li><a href="/">Acasă</a></li>
        {nav.map((n) => <li><a href={n.href} aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a></li>)}
        <li><a href="/contact/">Contact</a></li>
      </ul>
      <ul class="menu__sub">
        {aboutNav.slice(1).map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        <li><a href={company.english} hreflang="en" lang="en">English</a></li>
      </ul>
    </nav>
    <div class="menu__foot">
      <a href="/audit-gratuit/" class="btn">Cere un audit gratuit <Arrow /></a>
      <a href={`mailto:${company.email}`}>{company.email}</a>
      <a href={company.phoneHref}>{company.phone}</a>
    </div>
  </div>
</div>

<style>
  .hdr { position: sticky; top: 0; z-index: 50; background: var(--c-plum); color: #fff; transition: transform 0.45s var(--ease-out); }
  .hdr.is-hidden { transform: translateY(-100%); }
  .hdr__in { display: flex; align-items: center; justify-content: space-between; height: var(--header-h); gap: 1.5rem; }
  .hdr__logo { flex: none; display: inline-flex; align-items: center; min-height: 2.75rem; }
  .hdr__nav ul { display: flex; gap: clamp(0.1rem, 0.8vw, 0.6rem); }
  .hdr__link { position: relative; display: inline-flex; align-items: center; gap: 0.4rem; min-height: 2.75rem; background: none; border: 0; padding: 0 0.6rem; cursor: pointer; font-size: 0.9375rem; font-weight: 650; color: #fff; }
  .hdr__link::after { content: ''; position: absolute; left: 0.6rem; right: 0.6rem; bottom: 0.45rem; height: 2px; background: var(--hot); transform: scaleX(0); transform-origin: right; transition: transform 0.35s var(--ease-out); }
  .hdr__link:hover::after, .hdr__link.is-active::after, .hdr__link[aria-expanded='true']::after { transform: scaleX(1); transform-origin: left; }
  .hdr__link svg { transition: transform var(--dur) var(--ease); }
  .hdr__link[aria-expanded='true'] svg { transform: rotate(180deg); }
  .hdr__end { display: flex; align-items: center; gap: 0.5rem; }
  .hdr__lang, .hdr__contact { display: inline-flex; align-items: center; min-height: 2.75rem; padding: 0 0.6rem; font-size: 0.875rem; font-weight: 700; color: #fff; }
  .hdr__lang { letter-spacing: 0.08em; }
  .hdr__lang:hover, .hdr__contact:hover { color: var(--hot); }
  .hdr__cta { margin-left: 0.5rem; transition: box-shadow var(--dur) var(--ease), transform 0.25s var(--ease-out); }
  .hdr__burger { display: none; width: 3rem; height: 3rem; background: var(--magenta-ink); border: 0; padding: 0; cursor: pointer; position: relative; z-index: 2; color: #fff; }
  .hdr__burger i { position: absolute; left: 0.85rem; right: 0.85rem; height: 2px; background: currentColor; transition: transform var(--dur) var(--ease); }
  .hdr__burger i:nth-of-type(1) { top: 1.2rem; }
  .hdr__burger i:nth-of-type(2) { top: 1.7rem; right: 1.35rem; }
  .hdr__burger[aria-expanded='true'] i:nth-of-type(1) { transform: translateY(0.25rem) rotate(45deg); }
  .hdr__burger[aria-expanded='true'] i:nth-of-type(2) { right: 0.85rem; transform: translateY(-0.25rem) rotate(-45deg); }

  .mega { position: absolute; left: 0; right: 0; top: 100%; background: var(--cream); color: var(--c-plum); border-bottom: 6px solid var(--magenta); box-shadow: 0 40px 60px -30px rgba(43, 10, 32, 0.5); }
  .mega__in { display: grid; grid-template-columns: 1.3fr repeat(4, 1fr); gap: var(--gap); padding-block: 2.25rem 2.5rem; }
  .mega__intro { display: flex; flex-direction: column; justify-content: space-between; gap: 1.5rem; padding-right: 1.5rem; }
  .mega__intro .more { color: var(--c-plum); }
  .mega__label { display: flex; gap: 0.75rem; align-items: center; margin-bottom: 0.9rem; }
  .mega__label .icon-badge { width: 2.5rem; height: 2.5rem; }
  .mega__label strong { display: block; font-size: 1rem; }
  .mega__label small { display: block; font-size: 0.8125rem; color: #5e4a57; line-height: 1.3; }
  .mega__col li a { display: flex; align-items: center; min-height: 2.25rem; font-size: 0.9375rem; font-weight: 600; transition: color var(--dur); }
  .mega__col li.sub a { padding-left: 1rem; color: #5e4a57; font-size: 0.875rem; min-height: 2rem; }
  .mega__col li a:hover { color: var(--mark); }

  /* meniu pe tot ecranul: cerc magenta care se deschide din butonul de meniu */
  .menu { position: fixed; inset: 0; z-index: 40; padding-top: var(--header-h); overflow-y: auto; clip-path: circle(0 at var(--ox, 90%) var(--oy, 2rem)); transition: clip-path 0.55s cubic-bezier(0.76, 0, 0.24, 1); }
  .menu.is-open { clip-path: circle(150% at var(--ox, 90%) var(--oy, 2rem)); }
  .menu__in { display: flex; flex-direction: column; justify-content: space-between; min-height: 100%; padding-block: 1.5rem 2rem; gap: 2rem; }
  .menu__main li { overflow: hidden; }
  .menu__main a { display: flex; align-items: center; min-height: 3.5rem; font-size: clamp(2rem, 9vw, 3rem); font-weight: 800; letter-spacing: -0.045em; border-bottom: 1px solid var(--line); transform: translateY(100%); transition: transform 0.6s var(--ease-out); }
  .menu.is-open .menu__main a { transform: none; }
  .menu__main li:nth-child(2) a { transition-delay: 0.04s; } .menu__main li:nth-child(3) a { transition-delay: 0.08s; } .menu__main li:nth-child(4) a { transition-delay: 0.12s; }
  .menu__main li:nth-child(5) a { transition-delay: 0.16s; } .menu__main li:nth-child(6) a { transition-delay: 0.2s; } .menu__main li:nth-child(7) a { transition-delay: 0.24s; } .menu__main li:nth-child(8) a { transition-delay: 0.28s; }
  .menu__main a:hover, .menu__main a[aria-current='page'] { font-family: var(--serif); font-style: italic; font-weight: 400; letter-spacing: -0.02em; }
  .menu__sub { display: flex; flex-wrap: wrap; gap: 0 1.25rem; margin-top: 1.25rem; font-size: 1rem; font-weight: 600; }
  .menu__sub a { display: inline-flex; align-items: center; min-height: 2.75rem; text-decoration: underline; text-underline-offset: 0.2em; }
  .menu__foot { display: grid; gap: 0.25rem; font-size: 1.0625rem; font-weight: 600; }
  .menu__foot .btn { margin-bottom: 1rem; }
  .menu__foot a:not(.btn) { display: inline-flex; align-items: center; min-height: 2.75rem; }
  @media (prefers-reduced-motion: reduce) { .menu, .menu.is-open { clip-path: none; } .menu__main a { transform: none; } }

  @media (max-width: 1100px) {
    .hdr__nav, .hdr__lang, .hdr__contact, .mega { display: none !important; }
    .hdr__burger { display: block; }
  }
  @media (max-width: 480px) { .hdr__cta { display: none; } }
  @media (min-width: 1101px) { .menu { display: none !important; } }
  :global(body.menu-open) { overflow: hidden; }
  :global(body.menu-open) .hdr { background: transparent; }
</style>
