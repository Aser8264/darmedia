---
// Cele 11 servicii ca rânduri mari, grupate în cele 4 categorii existente.
// Desktop: la hover, o formă magenta urmărește cursorul și numele se deplasează. Touch/tastatură: tap/Enter deschide rândul (details nativ).
import Arrow from './Arrow.astro';
import { services, groups } from '../data/services';
interface Props { headingLevel?: 'h2' | 'h3' }
const { headingLevel: H = 'h3' } = Astro.props;
let n = 0;
---
<div class="svc">
  {groups.map((g) => {
    const top = services.filter((s) => s.group === g.id && !s.parent);
    return (
      <section class="svc__group" aria-label={g.label}>
        <div class="svc__label">
          <H class="svc__cat">{g.label}</H>
          <p class="svc__note">{g.note}</p>
        </div>
        <ul class="svc__rows">
          {top.map((s) => {
            n += 1;
            const subs = services.filter((x) => x.parent === s.slug);
            return (
              <li>
                <details class="svc__row">
                  <summary>
                    <span class="svc__name">{s.name}</span>
                    <span class="svc__plus" aria-hidden="true"></span>
                  </summary>
                  <div class="svc__body">
                    <p>{s.summary}</p>
                    {subs.length > 0 && (
                      <ul class="svc__subs" aria-label={`Platforme ${s.name}`}>{subs.map((x) => <li><a href={`/${x.slug}/`}>{x.name}</a></li>)}</ul>
                    )}
                    <a class="more" href={`/${s.slug}/`}>Despre {s.name} <Arrow /></a>
                  </div>
                </details>
              </li>
            );
          })}
        </ul>
      </section>
    );
  })}
</div>
<style>
  .svc { display: grid; gap: clamp(2.5rem, 5vw, 3.5rem); }
  .svc__group { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap); }
  .svc__label { grid-column: 1 / span 4; padding-top: 1.15rem; padding-right: 1rem; }
  .svc__cat { font-size: var(--fs-h4); font-weight: 650; letter-spacing: -0.015em; color: var(--fg); }
  .svc__note { font-size: var(--fs-sm); color: var(--fg-2); margin-top: 0.25rem; }
  .svc__rows { grid-column: 5 / -1; border-top: 1px solid var(--line-2); }
  .svc__rows > li { border-bottom: 1px solid var(--line); }
  .svc__row summary { position: relative; isolation: isolate; display: grid; grid-template-columns: 1fr 2rem; align-items: center; gap: 1rem; min-height: 4.25rem; padding: 0.75rem 0.75rem; cursor: pointer; list-style: none; }
  .svc__row summary::before { content: ''; position: absolute; inset: 0; z-index: -1; background: rgba(237, 30, 121, 0.09); transform: scaleX(0); transform-origin: left; transition: transform 0.45s var(--ease-out); }
  .svc__name { display: inline-block; transition: color 0.15s ease, transform 0.35s var(--ease-out) !important; }
  .svc__row[open] summary::before { transform: scaleX(1); }
  .svc__row summary::-webkit-details-marker { display: none; }
  .svc__name { font-size: clamp(1.35rem, 1.1rem + 1vw, 1.875rem); font-weight: 650; letter-spacing: -0.025em; line-height: 1.2; transition: color 0.15s ease; }
  .svc__plus { position: relative; justify-self: end; width: 2rem; height: 2rem; border: 1px solid var(--line-2); border-radius: 50%; transition: transform 0.25s var(--ease-out), border-color 0.15s ease; }
  .svc__plus::before, .svc__plus::after { content: ''; position: absolute; left: 50%; top: 50%; width: 0.7rem; height: 1.5px; background: currentColor; transform: translate(-50%, -50%); }
  .svc__plus::after { transform: translate(-50%, -50%) rotate(90deg); }
  .svc__row[open] .svc__plus { transform: rotate(45deg); border-color: var(--magenta); color: var(--mark); }
  .svc__body { display: grid; gap: 0.9rem; justify-items: start; padding: 1rem 3rem 1.75rem 0.75rem; max-width: 42rem; color: var(--fg-2); font-size: var(--fs-lg); }
  .svc__subs { display: flex; flex-wrap: wrap; gap: 0 1.25rem; }
  .svc__subs a { display: inline-flex; align-items: center; min-height: 2.5rem; font-weight: 600; color: var(--fg); text-decoration: underline; text-decoration-color: var(--magenta); text-underline-offset: 0.25em; }
  .svc__subs a:hover { color: var(--accent-text); }
  @media (hover: hover) and (pointer: fine) {
    .svc__row summary:hover .svc__name { color: var(--accent-text); transform: translateX(8px); }
    .svc__row summary:hover::before { transform: scaleX(1); }
    .svc__row summary:hover .svc__plus { transform: rotate(90deg); }
    .svc__row summary:hover .svc__plus { border-color: var(--fg); }
  }
  @supports selector(::details-content) {
    @media (prefers-reduced-motion: no-preference) {
      .svc { interpolate-size: allow-keywords; }
      .svc__row::details-content { block-size: 0; overflow: clip; transition: block-size 0.3s var(--ease-out), content-visibility 0.3s allow-discrete; }
      .svc__row[open]::details-content { block-size: auto; }
    }
  }
  @media (max-width: 900px) {
    .svc__label, .svc__rows { grid-column: 1 / -1; }
    .svc__label { padding: 0 0 0.75rem; }
    .svc__body { padding-right: 0; }
  }
</style>
