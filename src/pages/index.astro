---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import Mark from '../components/Mark.astro';
import ServiceList from '../components/ServiceList.astro';
import Testimonials from '../components/Testimonials.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import CaseCard from '../components/CaseCard.astro';
import LogoWall from '../components/LogoWall.astro';
import { company, partners, keyResults, stats, caseStudies, founders, clients, faq, googleReviews } from '../data/site';
import { posts, formatDate, postBySlug, coverSrcset } from '../data/posts';
import fondatori from '../assets/site/fondatori.webp';
import fDumitru from '../assets/site/f-dumitru.webp';
import fAdelina from '../assets/site/f-adelina.webp';
import fRadu from '../assets/site/f-radu.webp';
const portraits: Record<string, ImageMetadata> = { 'Dumitru Pascariu': fDumitru, 'Adelina Elena Ababei': fAdelina, 'Radu Dascălul': fRadu };
const latest = posts.slice(0, 3);
const cases = caseStudies.filter((c) => postBySlug(c.slug));
const statOrder = [stats[1], stats[2], stats[0]]; // 350+ proiecte · 4+ mil. € · 9+ ani
const heroLines = ['Strategii de omnichannel', 'marketing care îți aduc', 'leaduri și vânzări'];
const shapes = ['circle', 'arch', 'petal'];
---
<Base title="DAR Media — Agenție de digital marketing, Cluj-Napoca" colorShift>
  <!-- 1. Hero — magenta pe toată lățimea -->
  <section class="hero t-magenta" data-theme="magenta" data-hero aria-labelledby="hero-h">
    <div class="hero__deco" aria-hidden="true">
      <span class="hero__ghost" data-speed="-0.08">dar</span>
      <span class="hero__mark-wrap" data-speed="0.18"><Mark size={420} outline class="hero__mark spin" /></span>
      <span class="hero__dot float"></span>
    </div>
    <div class="wrap hero__in">
      <p class="eyebrow hero__eyebrow">Agenție de digital marketing · Cluj-Napoca · din {company.since}</p>
      <h1 class="hero__title lines is-anim" id="hero-h">
        {heroLines.map((l, i) => <span style={`--i:${i}`}><span>{l}</span></span>)}
        <span style="--i:3"><span><em>profitabile.</em></span></span>
      </h1>
      <div class="hero__split">
        <div class="hero__copy">
          <p class="hero__sub">Sprijinim afacerile aflate în faza de creștere &amp; scalare să genereze vânzări profitabile, clienți mulțumiți și impact pe termen lung.</p>
          <p class="hero__proof"><span><strong>350+</strong> proiecte</span> <i aria-hidden="true">·</i> <span><strong>4+ mil. €</strong> administrați</span> <i aria-hidden="true">·</i> <span><strong>9+</strong> ani</span></p>
          <div class="hero__actions">
            <a class="btn" href="/audit-gratuit/" data-magnetic>Cere un audit gratuit <Arrow /></a>
            <a class="btn btn--ghost" href="#rezultate">Vezi rezultatele</a>
          </div>
        </div>
        <figure class="hero__photo" data-speed="0.06">
          <span class="hero__frame" aria-hidden="true"></span>
          <span class="tape hero__tape" aria-hidden="true"></span>
          <Picture src={fondatori} formats={['avif', 'webp']} fallbackFormat="webp" widths={[400, 640, 900]} sizes="(max-width: 900px) 78vw, 30vw" alt="Dumitru, Adelina și Radu, fondatorii DAR Media, cu mâinile unite" loading="eager" fetchpriority="high" decoding="async" />
          <figcaption class="sticker hero__sticker"><span><b>D·A·R</b>fondatorii</span></figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- 2. Parteneri — bandă prună, marquee -->
  <section class="partners t-plum" data-theme="plum" data-lock aria-labelledby="partners-h">
    <h2 class="sr-only" id="partners-h">Parteneri și certificări</h2>
    <div class="partners__in">
      <p class="partners__label" aria-hidden="true">Parteneri &amp;<br />certificări</p>
      <LogoWall items={partners} variant="marquee" rows={1} label="Parteneri și certificări" />
    </div>
  </section>

  <!-- 3. Studii de caz — crem, scroll orizontal fixat pe desktop, glisare pe mobil -->
  <section class="cases t-cream" id="rezultate" data-theme="cream" data-hscroll aria-labelledby="cases-h">
    <div class="cases__sticky">
      <div class="wrap cases__head">
        <p class="eyebrow">Studii de caz</p>
        <h2 class="h2" id="cases-h">Rezultate <em>concrete,</em> nu promisiuni.</h2>
        <div class="cases__meta">
          <a class="more" href="/studii-de-caz/">Toate cele {caseStudies.length} studii <Arrow /></a>
          <span class="cases__bar" aria-hidden="true"><span></span></span>
        </div>
      </div>
      <ul class="cases__track" data-track aria-label="Studii de caz — derulează orizontal">
        {cases.map((c, i) => <li><CaseCard c={c} i={i} /></li>)}
        <li class="cases__end"><a href="/studii-de-caz/" data-cursor-label="Toate"><span>Toate studiile de caz</span><Arrow /></a></li>
      </ul>
    </div>
  </section>

  <!-- 4. Ce facem — roz pal, tipografie deschisă, listă numerotată asimetrică -->
  <section class="section manifest t-pink" data-theme="pink" aria-labelledby="man-h">
    <span class="manifest__ghost outline-text" aria-hidden="true" data-speed="0.1">DAR</span>
    <div class="wrap">
      <div class="manifest__top">
        <p class="eyebrow">Ce facem</p>
        <h2 class="manifest__title" id="man-h"><span>Darul tău,</span> <span><em>darul</em> nostru.</span></h2>
        <dl class="gifts">
          <div data-reveal><dt>Darul tău</dt><dd>O afacere cu potențial de creștere, care livrează produse și servicii excelente.</dd></div>
          <div data-reveal style="--d:120ms"><dt>Darul nostru</dt><dd>Strategii de omnichannel marketing care îți aduc leaduri și vânzări profitabile.</dd></div>
        </dl>
      </div>
      <ol class="pillars">
        {keyResults.map((k, i) => (
          <li data-reveal style={`--d:${(i % 2) * 90}ms`}>
            <span class="pillars__n">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="pillars__t">{k.title}</h3>
            <p>{k.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 5. Servicii — prună, rânduri mari -->
  <section class="section services t-plum" id="servicii" data-theme="plum" aria-labelledby="svc-h">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">Servicii</p>
        <h2 class="h2" id="svc-h">Servicii de marketing digital, focusate pe <em>rezultate</em> concrete.</h2>
        <a class="more sec-aside" href="/servicii/">Toate serviciile <Arrow /></a>
      </div>
      <ServiceList />
    </div>
  </section>

  <!-- 6. Cifre — magenta, numere care cresc, așezare în diagonală -->
  <section class="section numbers t-magenta" data-theme="magenta" aria-labelledby="num-h">
    <div class="wrap">
      <div class="numbers__head">
        <p class="eyebrow">Numerele vorbesc</p>
        <h2 class="h2" id="num-h">Suntem mereu pregătiți pentru o <em>nouă</em> provocare.</h2>
      </div>
      <dl class="numbers__list">
        {statOrder.map((s, i) => (
          <div class={`numbers__item numbers__item--${i}`}>
            <dt>{s.label}</dt>
            <dd class="numbers__val"><span data-count={parseFloat(s.value)}>{parseFloat(s.value)}</span>+{s.unit && <small>{s.unit}</small>}</dd>
            <dd class="numbers__note">{s.note}</dd>
          </div>
        ))}
      </dl>
      <p class="numbers__g">
        <span class="stars" aria-hidden="true">★★★★★</span>
        <span><strong>{googleReviews.rating}</strong> pe Google, pe baza a {googleReviews.count} de recenzii.</span>
        <a class="link" href="/portofoliu/#recenzii">Citește recenziile</a>
      </p>
    </div>
  </section>

  <Testimonials />

  <!-- 8. Echipa — roz, portrete în forme din emblemă, așezate în trepte -->
  <section class="section team t-pink" data-theme="pink" aria-labelledby="team-h">
    <div class="wrap">
      <div class="team__top">
        <div>
          <p class="eyebrow">Despre noi</p>
          <h2 class="h2" id="team-h">Echipa ta creativă de marketing, care îți aduce <em>rezultate</em> măsurate.</h2>
        </div>
        <div class="team__note" data-reveal>
          <p class="team__lead">Numele a apărut de la inițialele prenumelor noastre — Dumitru, Adelina, Radu — și de la ideea că orice om și orice business are un dar prețios de oferit celorlalți.</p>
          <p class="muted">Credem cu tărie în forța echipei noastre, formată din colegi tineri, creativi și orientați spre rezultate. Atuurile noastre sunt comunicarea, transparența, evoluția continuă și relațiile solide construite între noi.</p>
          <p class="team__links"><a class="more" href="/povestea-noastra/">Povestea noastră <Arrow /></a><a class="more" href="/echipa-darmedia/">Vezi echipa <Arrow /></a></p>
        </div>
      </div>
      <ul class="team__grid">
        {founders.map((f, i) => (
          <li class={`team__m team__m--${shapes[i]}`} data-reveal style={`--d:${i * 110}ms`}>
            <div class="team__pic">
              <span class="team__letter" aria-hidden="true">{f.initial}</span>
              <Picture src={portraits[f.name]} formats={['avif', 'webp']} fallbackFormat="webp" widths={[240, 450]} sizes="(max-width: 640px) 70vw, 28vw" alt={f.name} loading="lazy" decoding="async" />
            </div>
            <h3 class="h4">{f.name}</h3>
            <p class="muted small">{f.role}</p>
            <a class="team__in" href={f.links.LinkedIn} target="_blank" rel="noopener noreferrer">LinkedIn<span class="sr-only"> — {f.name} (se deschide într-o filă nouă)</span></a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 9. Clienți — bandă prună, marquee pe două rânduri -->
  <section class="clients t-plum" data-theme="plum" data-lock aria-labelledby="cl-h">
    <div class="wrap clients__head">
      <h2 class="clients__title" id="cl-h">Au ales <em>DAR Media</em></h2>
      <a class="more" href="/portofoliu/">Portofoliu · {clients.length} branduri <Arrow /></a>
    </div>
    <LogoWall items={clients} variant="marquee" label={`Logourile celor ${clients.length} de clienți DAR Media`} />
  </section>

  <!-- 10. FAQ — crem, rânduri deschise -->
  <section class="section faqs t-cream" data-theme="cream" aria-labelledby="faq-h">
    <div class="wrap faqs__in">
      <div class="faqs__head">
        <p class="eyebrow">Întrebări frecvente</p>
        <h2 class="h2" id="faq-h">Răspunsuri <em>directe,</em> înainte de primul call.</h2>
        <p class="muted">Nu ai găsit răspunsul? <a class="link" href="/contact/">Scrie-ne</a> sau <a class="link" href={company.calendly} target="_blank" rel="noopener noreferrer">programează o discuție</a>.</p>
      </div>
      <div class="faqs__list"><Faq items={faq} /></div>
    </div>
  </section>

  <!-- 11. Resurse — roz, linkuri mari + articole cu imagini rotite și bandă adezivă -->
  <section class="section learn t-pink" data-theme="pink" aria-labelledby="learn-h">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">Învață să te promovezi mai eficient, la un cost mai mic</p>
        <h2 class="h2" id="learn-h">Afacerea ta crește prin educație continuă de marketing &amp; <em>business.</em></h2>
      </div>
      <div class="learn__grid">
        <ul class="learn__links">
          <li><a href="/ebook/"><span>Ebook-uri gratuite</span><Arrow /></a></li>
          <li><a href="/blog/"><span>Blog</span><Arrow /></a></li>
          <li><a href={company.social[3].href} target="_blank" rel="noopener noreferrer"><span>Video<span class="sr-only"> (YouTube, se deschide într-o filă nouă)</span></span><Arrow dir="up-right" /></a></li>
        </ul>
        <ul class="learn__posts">
          {latest.map((p, i) => (
            <li class={`learn__post learn__post--${i}`} data-reveal style={`--d:${i * 90}ms`}>
              <a href={`/${p.slug}/`}>
                <span class="learn__img">
                  <span class="tape" aria-hidden="true"></span>
                  {p.cover && <img src={p.cover.src} width={p.cover.width} height={p.cover.height} srcset={coverSrcset(p.cover)} sizes="(max-width: 900px) 80vw, 24vw" alt="" loading="lazy" decoding="async" />}
                </span>
                <span class="tag">{p.categories[0]} · {formatDate(p.date)}</span>
                <span class="learn__title">{p.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <Cta />
</Base>

<style>
  /* ---------- 1. hero */
  .hero { position: relative; overflow: hidden; isolation: isolate; }
  .hero__deco { position: absolute; inset: 0; z-index: -1; pointer-events: none; }
  .hero__ghost { position: absolute; left: -2vw; bottom: -0.2em; font-size: var(--fs-giant); font-weight: 850; letter-spacing: -0.07em; line-height: 0.75; color: transparent; -webkit-text-stroke: 2px rgba(255, 255, 255, 0.35); }
  .hero__mark-wrap { position: absolute; right: -7rem; top: -5rem; width: clamp(16rem, 38vw, 34rem); }
  .hero__mark-wrap :global(.hero__mark) { width: 100%; height: auto; color: var(--magenta); opacity: 1; }
  .hero__mark-wrap :global(svg path) { stroke: rgba(255, 255, 255, 0.5); }
  .hero__dot { position: absolute; right: 30%; bottom: 8%; width: clamp(3rem, 6vw, 5rem); aspect-ratio: 1; border-radius: 50%; background: var(--c-plum); }
  .hero__in { position: relative; padding-block: clamp(2rem, 4.5vw, 4rem) clamp(4rem, 9vw, 7rem); }
  .hero__eyebrow { margin-bottom: clamp(1.25rem, 3vw, 2rem); }
  .hero__title { font-size: clamp(2.75rem, 0.8rem + 5.3vw, 6.5rem); font-weight: 850; line-height: 0.9; letter-spacing: -0.06em; }
  .hero__title em { font-family: var(--serif); font-weight: 400; letter-spacing: -0.02em; color: #fff; }
  .hero__split { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap); align-items: start; margin-top: clamp(1.75rem, 3vw, 2.5rem); }
  .hero__copy { grid-column: 1 / span 6; display: grid; gap: 1.5rem; justify-items: start; padding-top: 0.5rem; }
  .hero__sub { font-size: var(--fs-lg); line-height: 1.5; max-width: 34rem; font-weight: 500; }
  .hero__proof { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.35rem 0.6rem; padding: 0.9rem 0; border-block: 2px solid #fff; font-size: var(--fs-base); font-weight: 600; }
  .hero__proof strong { font-size: clamp(1.35rem, 1rem + 1.2vw, 1.9rem); font-weight: 850; letter-spacing: -0.04em; }
  .hero__proof span { white-space: nowrap; }
  .hero__proof i { font-style: normal; opacity: 0.8; margin-inline: 0.15rem; }
  @media (max-width: 480px) { .hero__proof i { display: none; } .hero__proof { gap: 0.25rem 1.1rem; } }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 0.5rem; }
  .hero__actions .btn { transition: box-shadow var(--dur) var(--ease), transform 0.25s var(--ease-out); }
  .hero__photo { grid-column: 8 / -1; position: relative; margin-top: clamp(-11rem, -12vw, -4rem); }
  .hero__photo :global(img) { position: relative; width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 30%; border-radius: var(--arch); rotate: 3deg; }
  .hero__frame { position: absolute; inset: 0; border: 3px solid var(--c-plum); border-radius: var(--arch); translate: -1.25rem 1.25rem; rotate: -2deg; }
  .hero__tape { top: -0.5rem; left: 50%; translate: -50% 0; rotate: -6deg; }
  .hero__sticker { left: -2.5rem; bottom: 12%; background: var(--c-plum); }
  .hero__sticker b { font-size: 1.35rem; letter-spacing: 0.02em; }

  /* ---------- 2. parteneri */
  .partners__in { display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: center; gap: 1.5rem; padding-block: 1.5rem; padding-left: var(--gutter); }
  .partners__label { font-size: var(--fs-xs); font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; color: var(--hot); line-height: 1.4; }

  /* ---------- 3. studii de caz */
  .cases { position: relative; }
  .cases__sticky { padding-block: var(--section) calc(var(--section) * 0.7); }
  .cases__head { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap); row-gap: 1rem; align-items: end; margin-bottom: clamp(2rem, 4vw, 3.5rem); }
  .cases__head .eyebrow { grid-column: 1 / -1; }
  .cases__head .h2 { grid-column: 1 / span 8; }
  .cases__meta { grid-column: 9 / -1; display: grid; gap: 0.75rem; justify-items: end; }
  .cases__bar { display: none; width: 100%; height: 3px; background: var(--line); }
  .cases__bar span { display: block; height: 100%; background: var(--magenta); transform-origin: left; transform: scaleX(var(--progress, 0)); }
  .cases__track { display: flex; gap: clamp(1.5rem, 3vw, 3rem); padding-inline: var(--gutter); overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; overscroll-behavior-x: contain; }
  .cases__track::-webkit-scrollbar { display: none; }
  .cases__track > li { flex: none; width: min(82vw, 26rem); scroll-snap-align: start; scroll-margin-left: var(--gutter); }
  .cases__end a { display: flex; flex-direction: column; justify-content: center; gap: 1rem; height: 100%; min-height: 16rem; padding: 2rem; background: var(--c-plum); color: #fff; font-size: clamp(1.75rem, 1rem + 2vw, 2.75rem); font-weight: 850; letter-spacing: -0.05em; line-height: 1; clip-path: polygon(0 0, 100% 6%, 100% 100%, 0 94%); transition: clip-path 0.6s var(--ease-out); }
  .cases__end a:hover { clip-path: polygon(0 6%, 100% 0, 100% 94%, 0 100%); }
  .cases__end :global(.arrow) { width: 2.5rem; height: 2.5rem; color: var(--hot); }
  @media (min-width: 1024px) and (prefers-reduced-motion: no-preference) {
    .cases__sticky { position: sticky; top: 0; height: 100vh; display: flex; flex-direction: column; justify-content: center; overflow: hidden; padding-block: calc(var(--header-h) + 1rem) 2rem; }
    .cases__bar { display: block; }
    .cases__track { overflow: visible; scroll-snap-type: none; will-change: transform; }
    .cases__track > li { width: clamp(22rem, 30vw, 30rem); }
    .cases__track > li:nth-child(even) { margin-top: 3rem; }
  }
  @media (min-width: 1024px) { .cases__track > li { width: clamp(22rem, 30vw, 30rem); } }

  /* ---------- 4. manifest */
  .manifest { overflow: hidden; isolation: isolate; }
  .manifest__ghost { position: absolute; z-index: -1; right: -3vw; top: 10%; font-size: var(--fs-giant); font-weight: 850; letter-spacing: -0.07em; line-height: 0.8; color: transparent; -webkit-text-stroke: 2px var(--magenta); opacity: 0.55; }
  .manifest__top { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap); row-gap: 1.5rem; margin-bottom: clamp(3rem, 7vw, 6rem); }
  .manifest__top .eyebrow { grid-column: 1 / -1; }
  .manifest__title { grid-column: 1 / span 9; font-size: clamp(3rem, 1.4rem + 7vw, 8.5rem); font-weight: 850; line-height: 0.88; letter-spacing: -0.065em; }
  .manifest__title span { display: block; }
  .manifest__title span + span { padding-left: clamp(2rem, 14vw, 14rem); }
  .manifest__title em { font-family: var(--serif); font-weight: 400; letter-spacing: -0.02em; color: var(--accent-text); }
  .gifts { grid-column: 6 / -1; display: grid; grid-template-columns: 1fr 1fr; gap: var(--gap); margin-top: 1rem; }
  .gifts > div { padding-top: 0.9rem; border-top: 3px solid var(--magenta); display: grid; gap: 0.5rem; align-content: start; }
  .gifts dt { font-size: var(--fs-xs); font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent-text); }
  .gifts dd { font-size: var(--fs-lg); line-height: 1.4; font-weight: 600; text-wrap: pretty; }
  .pillars { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: clamp(2rem, 6vw, 6rem); }
  .pillars li { display: grid; grid-template-columns: auto 1fr; column-gap: 1.25rem; padding-block: 1.75rem; border-top: 2px solid var(--fg); }
  .pillars li:nth-child(even) { translate: 0 clamp(2rem, 6vw, 5rem); }
  .pillars__n { grid-row: span 2; font-size: clamp(2.5rem, 1.5rem + 3vw, 4.5rem); font-weight: 850; letter-spacing: -0.06em; line-height: 0.85; color: var(--magenta-ink); }
  .pillars__t { font-size: var(--fs-h3); font-weight: 800; letter-spacing: -0.035em; line-height: 1.1; }
  .pillars p { color: var(--fg-2); margin-top: 0.5rem; max-width: 30rem; }

  /* ---------- 6. cifre */
  .numbers { overflow: hidden; }
  .numbers__head { display: grid; gap: 1.25rem; max-width: 44rem; margin-bottom: clamp(2.5rem, 6vw, 5rem); }
  .numbers__list { display: grid; gap: clamp(2rem, 4vw, 3rem); }
  .numbers__item { display: grid; grid-template-columns: minmax(0, auto) minmax(0, 22rem); column-gap: clamp(1.5rem, 4vw, 4rem); align-items: end; padding-top: 1.25rem; border-top: 2px solid #fff; }
  .numbers__item--1 { margin-left: clamp(0rem, 16vw, 20rem); }
  .numbers__item--2 { margin-left: clamp(0rem, 32vw, 40rem); }
  .numbers__item dt { grid-column: 1 / -1; font-size: var(--fs-xs); font-weight: 800; letter-spacing: 0.16em; text-transform: uppercase; }
  .numbers__val { font-size: clamp(5rem, 2rem + 13vw, 14rem); font-weight: 850; line-height: 0.82; letter-spacing: -0.075em; font-variant-numeric: tabular-nums; }
  .numbers__val small { font-size: 0.24em; letter-spacing: -0.03em; margin-left: 0.25em; }
  .numbers__note { font-size: var(--fs-base); font-weight: 500; padding-bottom: 0.5rem; }
  .numbers__g { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1rem; margin-top: clamp(2.5rem, 5vw, 4rem); font-weight: 500; }
  .stars { letter-spacing: 0.1em; color: #fff; font-size: 1.1rem; }

  /* ---------- 8. echipa */
