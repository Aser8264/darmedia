---
import { testimonials } from '../data/site';
interface Props { title?: string }
const { title = 'Ce spun <em>clienții</em> noștri' } = Astro.props;
---
<section class="section tst t-pink" aria-labelledby="tst-h">
  <div class="wrap">
    <div class="tst__head">
      <p class="eyebrow">Testimoniale</p>
      <h2 class="h2" id="tst-h" set:html={title} />
    </div>
    <div class="tst__body" data-tst>
      <div class="tst__tabs" role="tablist" aria-label="Clienți">
        {testimonials.map((t, i) => (
          <button role="tab" type="button" id={`tst-tab-${i}`} aria-controls={`tst-panel-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
            <span>{t.short}</span>
          </button>
        ))}
      </div>
      <div class="tst__panels">
        {testimonials.map((t, i) => (
          <div role="tabpanel" class="tst__panel" id={`tst-panel-${i}`} aria-labelledby={`tst-tab-${i}`} hidden={i !== 0} tabindex="0"><figure>
            <blockquote>
              <p class="tst__first">{t.quote[0]}</p>
              {t.quote.slice(1).map((q) => <p class="tst__rest">{q}</p>)}
            </blockquote>
            <figcaption><strong>{t.name}</strong><span>{t.role}</span></figcaption>
          </figure></div>
        ))}
      </div>
    </div>
  </div>
</section>
<style>
  .tst__head { margin-bottom: clamp(2rem, 4vw, 3rem); }
  .tst__body { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 2rem var(--gap); align-items: start; }
  .tst__tabs { grid-column: 1 / span 3; display: grid; border-top: 1px solid var(--line-2); }
  .tst__tabs button { display: flex; align-items: center; min-height: 3rem; padding: 0; background: none; border: 0; border-bottom: 1px solid var(--line); text-align: left; cursor: pointer; font-size: 1rem; font-weight: 550; color: var(--fg-2); transition: color 0.15s ease; }
  .tst__tabs button:hover { color: var(--fg); }
  .tst__tabs button[aria-selected='true'] { color: var(--fg); font-weight: 700; box-shadow: inset 2px 0 0 var(--magenta); padding-left: 0.85rem; }
  .tst__panels { grid-column: 5 / -1; }
  .tst__first { font-size: clamp(1.375rem, 1.1rem + 1vw, 2rem); font-weight: 600; line-height: 1.32; letter-spacing: -0.02em; max-width: 40rem; }
  .tst__first::before { content: '„'; color: var(--magenta); }
  .tst__first::after { content: '”'; color: var(--magenta); }
  .tst__rest { margin-top: 1rem; max-width: 40rem; color: var(--fg-2); font-size: var(--fs-lg); }
  figcaption { display: flex; flex-wrap: wrap; gap: 0.25rem 0.75rem; align-items: baseline; margin-top: 1.75rem; }
  figcaption strong { font-size: var(--fs-base); }
  figcaption span { color: var(--fg-2); font-size: var(--fs-sm); }
  .js .tst__panel:not([hidden]) { animation: tst-in 0.25s var(--ease-out); }
  @keyframes tst-in { from { opacity: 0; } }
  @media (max-width: 900px) {
    .tst__tabs { grid-column: 1 / -1; display: flex; overflow-x: auto; gap: 1.25rem; border-top: 0; border-bottom: 1px solid var(--line); scrollbar-width: none; margin-inline: calc(var(--gutter) * -1); padding-inline: var(--gutter); }
    .tst__tabs button { flex: none; border-bottom: 2px solid transparent; font-size: 0.9375rem; min-height: 2.75rem; }
    .tst__tabs button[aria-selected='true'] { box-shadow: none; padding-left: 0; border-bottom-color: var(--magenta); }
    .tst__panels { grid-column: 1 / -1; }
  }
</style>
<script>
  document.querySelectorAll<HTMLElement>('[data-tst]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role=tab]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[role=tabpanel]')];
    const select = (i: number, focus = false) => {
      tabs.forEach((t, j) => { t.setAttribute('aria-selected', String(i === j)); t.tabIndex = i === j ? 0 : -1; });
      panels.forEach((p, j) => (p.hidden = i !== j));
      if (focus) tabs[i].focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(i));
      t.addEventListener('keydown', (e) => {
        if (['ArrowDown', 'ArrowRight'].includes(e.key)) { e.preventDefault(); select((i + 1) % tabs.length, true); }
        if (['ArrowUp', 'ArrowLeft'].includes(e.key)) { e.preventDefault(); select((i - 1 + tabs.length) % tabs.length, true); }
      });
    });
  });
</script>
