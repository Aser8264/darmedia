---
import Logo from './Logo.astro';
import Arrow from './Arrow.astro';
import Icon from './Icon.astro';
import { nav, aboutNav, company } from '../data/site';
import { services, groups } from '../data/services';
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href));
const groupIcon = { fundament: 'compass', achizitie: 'magnet', retentie: 'repeat', brand: 'spark' } as const;
---
<header class="hdr" data-header>
  <div class="wrap hdr__in">
    <a href="/" class="hdr__logo"><Logo /><span class="sr-only"> — acasă</span></a>
    <nav class="hdr__nav" aria-label="Navigație principală">
      <ul>
        {nav.map((n) => (
          <li>
            {n.href === '/servicii/' ? (
              <button type="button" class:list={['hdr__link', { 'is-active': isActive(n.href) }]} aria-expanded="false" aria-controls="mega" data-mega-toggle>
                {n.label}<svg viewBox="0 0 10 6" width="10" height="6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
              </button>
            ) : (
              <a href={n.href} class:list={['hdr__link', { 'is-active': isActive(n.href) }]} aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a>
            )}
          </li>
        ))}
      </ul>
    </nav>
    <div class="hdr__end">
      <a href={company.english} class="hdr__lang" hreflang="en" lang="en"><span aria-hidden="true">EN</span><span class="sr-only">English version</span></a>
      <a href="/contact/" class="hdr__contact">Contact</a>
      <a href="/audit-gratuit/" class="btn btn--sm hdr__cta">Audit gratuit</a>
      <button type="button" class="hdr__burger" aria-expanded="false" aria-controls="menu" data-menu-toggle>
        <span class="sr-only">Meniu</span><i></i><i></i>
      </button>
    </div>
  </div>

  <div class="mega" id="mega" hidden data-mega>
    <div class="wrap mega__in">
      <div class="mega__intro">
        <p class="h4">Servicii de marketing digital, focusate pe rezultate concrete.</p>
        <a href="/servicii/" class="more">Toate serviciile <Arrow /></a>
      </div>
      {groups.map((g) => (
        <div class="mega__col">
          <p class="mega__label"><span><strong>{g.label}</strong><small>{g.note}</small></span></p>
          <ul>
            {services.filter((s) => s.group === g.id).map((s) => (
              <li class:list={{ sub: !!s.parent }}><a href={`/${s.slug}/`}>{s.name}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</header>

<div class="menu" id="menu" hidden data-menu>
  <div class="wrap menu__in">
    <nav aria-label="Meniu mobil">
      <ul class="menu__main">
        <li><a href="/">Acasă</a></li>
        {nav.map((n) => <li><a href={n.href} aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a></li>)}
        <li><a href="/contact/">Contact</a></li>
      </ul>
      <ul class="menu__sub">
        {aboutNav.slice(1).map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        <li><a href={company.english} hreflang="en" lang="en">English</a></li>
      </ul>
    </nav>
    <div class="menu__foot">
      <a href="/audit-gratuit/" class="btn">Cere un audit gratuit <Arrow /></a>
      <a href={`mailto:${company.email}`}>{company.email}</a>
      <a href={company.phoneHref}>{company.phone}</a>
    </div>
  </div>
</div>

<style>
  .hdr { position: sticky; top: 0; z-index: 50; background: rgba(244, 239, 232, 0.94); -webkit-backdrop-filter: saturate(150%) blur(10px); backdrop-filter: saturate(150%) blur(10px); color: var(--c-plum); border-bottom: 1px solid transparent; transition: transform 0.3s var(--ease-out), border-color 0.2s ease; }
  .hdr.is-scrolled { border-bottom-color: var(--line); }
  .hdr.is-hidden { transform: translateY(-100%); }
  .hdr__in { display: flex; align-items: center; justify-content: space-between; height: var(--header-h); gap: 1.5rem; }
  .hdr__logo { flex: none; display: inline-flex; align-items: center; min-height: 2.75rem; }
  .hdr__nav ul { display: flex; gap: clamp(0.1rem, 0.7vw, 0.5rem); }
  .hdr__link { position: relative; display: inline-flex; align-items: center; gap: 0.35rem; min-height: 2.75rem; background: none; border: 0; padding: 0 0.6rem; cursor: pointer; font-size: 0.9375rem; font-weight: 550; color: var(--c-plum); border-radius: var(--r-sm); transition: color 0.15s ease; }
  .hdr__link:hover, .hdr__link[aria-expanded='true'] { color: var(--mark); }
  .hdr__link.is-active { color: var(--mark); }
  .hdr__link::after { content: ''; position: absolute; left: 0.6rem; right: 0.6rem; bottom: 0.5rem; height: 1.5px; background: var(--magenta); transform: scaleX(0); transform-origin: right; transition: transform 0.3s var(--ease-out); }
  .hdr__link:hover::after, .hdr__link.is-active::after, .hdr__link[aria-expanded='true']::after { transform: scaleX(1); transform-origin: left; }
  .hdr__link svg { transition: transform 0.2s var(--ease-out); }
  .hdr__link[aria-expanded='true'] svg { transform: rotate(180deg); }
  .hdr__end { display: flex; align-items: center; gap: 0.35rem; }
  .hdr__lang, .hdr__contact { display: inline-flex; align-items: center; min-height: 2.75rem; padding: 0 0.6rem; font-size: 0.9375rem; font-weight: 550; color: var(--c-plum); }
  .hdr__lang { font-size: 0.8125rem; font-weight: 650; letter-spacing: 0.06em; color: #5e4a57; }
  .hdr__lang:hover, .hdr__contact:hover { color: var(--mark); }
  .hdr__cta { margin-left: 0.5rem; }
  .hdr__burger { display: none; width: 2.75rem; height: 2.75rem; background: none; border: 1px solid var(--line-2); border-radius: var(--r-sm); padding: 0; cursor: pointer; position: relative; z-index: 2; color: var(--c-plum); }
  .hdr__burger i { position: absolute; left: 0.75rem; right: 0.75rem; height: 1.5px; background: currentColor; transition: transform 0.2s var(--ease-out); }
  .hdr__burger i:nth-of-type(1) { top: 1.05rem; }
  .hdr__burger i:nth-of-type(2) { top: 1.55rem; }
  .hdr__burger[aria-expanded='true'] i:nth-of-type(1) { transform: translateY(0.25rem) rotate(45deg); }
  .hdr__burger[aria-expanded='true'] i:nth-of-type(2) { transform: translateY(-0.25rem) rotate(-45deg); }

  .mega { position: absolute; left: 0; right: 0; top: 100%; background: var(--paper); color: var(--c-plum); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); box-shadow: 0 24px 48px -28px rgba(43, 10, 32, 0.3); }
  .mega__in { display: grid; grid-template-columns: 1.3fr repeat(4, 1fr); gap: var(--gap); padding-block: 2rem 2.25rem; }
  .mega__intro { display: flex; flex-direction: column; justify-content: space-between; gap: 1.5rem; padding-right: 1.5rem; }
  .mega__label { margin-bottom: 0.75rem; }
  .mega__label strong { display: block; font-size: 1rem; }
  .mega__label small { display: block; font-size: 0.8125rem; color: #5e4a57; line-height: 1.35; }
  .mega__col li a { display: flex; align-items: center; min-height: 2.25rem; font-size: 0.9375rem; transition: color 0.15s ease; }
  .mega__col li.sub a { padding-left: 0.9rem; color: #5e4a57; font-size: 0.875rem; min-height: 2rem; }
  .mega__col li a { transition: color 0.15s ease, transform 0.25s var(--ease-out); }
  .mega__col li a:hover { color: var(--mark); transform: translateX(4px); }
  .mega:not([hidden]) { animation: mega-in 0.22s var(--ease-out); }
  @keyframes mega-in { from { opacity: 0; transform: translateY(-6px); } }

  .menu { position: fixed; inset: 0; z-index: 40; padding-top: var(--header-h); overflow-y: auto; background: var(--cream); color: var(--c-plum); opacity: 0; transform: translateY(-8px); transition: opacity 0.2s ease, transform 0.25s var(--ease-out); }
  .menu.is-open { opacity: 1; transform: none; }
  .menu__in { display: flex; flex-direction: column; justify-content: space-between; min-height: 100%; padding-block: 1.25rem 2rem; gap: 2rem; }
  .menu__main a { display: flex; align-items: center; min-height: 3.25rem; font-size: clamp(1.75rem, 7vw, 2.4rem); font-weight: 700; letter-spacing: -0.03em; border-bottom: 1px solid var(--line); }
  .menu__main a:hover, .menu__main a[aria-current='page'] { color: var(--mark); }
  .menu__sub { display: flex; flex-wrap: wrap; gap: 0 1.25rem; margin-top: 1rem; font-size: 1rem; color: #5e4a57; }
  .menu__sub a { display: inline-flex; align-items: center; min-height: 2.75rem; }
  .menu__foot { display: grid; gap: 0.25rem; font-size: 1.0625rem; }
  .menu__foot .btn { margin-bottom: 1rem; }
  .menu__foot a:not(.btn) { display: inline-flex; align-items: center; min-height: 2.75rem; }

  @media (max-width: 1100px) {
    .hdr__nav, .hdr__lang, .hdr__contact, .mega { display: none !important; }
    .hdr__burger { display: block; }
  }
  @media (max-width: 480px) { .hdr__cta { display: none; } }
  @media (min-width: 1101px) { .menu { display: none !important; } }
  :global(body.menu-open) { overflow: hidden; }
</style>
