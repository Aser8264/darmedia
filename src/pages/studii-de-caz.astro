---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Testimonials from '../components/Testimonials.astro';
import Cta from '../components/Cta.astro';
import CaseCard from '../components/CaseCard.astro';
import { caseStudies } from '../data/site';
import { postBySlug, formatDate } from '../data/posts';
const cases = caseStudies.map((c) => ({ c, post: postBySlug(c.slug)! })).filter((x) => x.post);
---
<Base title="Studii de caz" description="Povestiri din lumea marketingului. Află cum am generat concret rezultate pentru clienții DAR Media.">
  <PageHero eyebrow="Studii de caz" title="Povestiri din lumea marketingului, <em>cu cifre.</em>" lead="Află cum am generat concret rezultate pentru clienții DAR Media! Oferim și alte exemple relevante în call, în funcție de industrie." crumbs={[{ label: 'Studii de caz' }]} />
  <section class="section cs" aria-label="Toate studiile de caz">
    <div class="wrap">
      <ul class="cs__grid">
        {cases.map(({ c, post }, i) => (
          <li data-reveal style={`--d:${(i % 2) * 80}ms`}>
            <CaseCard c={c} i={i} title={post.title} date={formatDate(post.date)} headingLevel="h2" />
          </li>
        ))}
      </ul>
    </div>
  </section>
  <Testimonials />
  <Cta title="Vrei să fii <em>următorul</em> studiu de caz?" />
</Base>
<style>
  .cs__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--gap); }
  .cs__grid > li { display: flex; }
  .cs__grid > li > :global(a) { flex: 1; }
  @media (max-width: 760px) { .cs__grid { grid-template-columns: 1fr; } }
</style>
