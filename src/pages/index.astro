---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import Icon from '../components/Icon.astro';
import Mark from '../components/Mark.astro';
import ServiceList from '../components/ServiceList.astro';
import Testimonials from '../components/Testimonials.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import CaseCard from '../components/CaseCard.astro';
import LogoWall from '../components/LogoWall.astro';
import { company, partners, keyResults, stats, caseStudies, founders, clients, faq, googleReviews } from '../data/site';
import { posts, formatDate, postBySlug , coverSrcset } from '../data/posts';
import fondatori from '../assets/site/fondatori.webp';
import fDumitru from '../assets/site/f-dumitru.webp';
import fAdelina from '../assets/site/f-adelina.webp';
import fRadu from '../assets/site/f-radu.webp';
const portraits: Record<string, ImageMetadata> = { 'Dumitru Pascariu': fDumitru, 'Adelina Elena Ababei': fAdelina, 'Radu Dascălul': fRadu };
const latest = posts.slice(0, 3);
const cases = caseStudies.filter((c) => c.featured && postBySlug(c.slug));
const pillarIcon = ['compass', 'users', 'cursor', 'repeat'] as const;
const proof = [stats[1], stats[2], stats[0]]; // 350+ proiecte · 4+ mil. € · 9+ ani
---
<Base title="DAR Media — Agenție de digital marketing, Cluj-Napoca">
  <!-- Hero -->
  <section class="hero" data-hero aria-labelledby="hero-h">
    <div class="hero__bg" aria-hidden="true"><Mark size={900} class="hero__mark" /></div>
    <div class="wrap hero__in">
      <p class="eyebrow">Agenție de digital marketing · Cluj-Napoca · din {company.since}</p>
      <h1 class="display hero__title" id="hero-h">Strategii de omnichannel marketing care îți aduc leaduri și vânzări <em>profitabile.</em></h1>
      <p class="lead hero__sub">Sprijinim afacerile aflate în faza de creștere &amp; scalare să genereze vânzări profitabile, clienți mulțumiți și impact pe termen lung.</p>
      <ul class="hero__proof" aria-label="DAR Media în cifre">
        <li><strong>350+</strong> proiecte</li>
        <li><strong>4+ mil. €</strong> administrați</li>
        <li><strong>9+</strong> ani</li>
      </ul>
      <div class="hero__actions">
        <a class="btn" href="/audit-gratuit/">Cere un audit gratuit <Arrow /></a>
        <a class="btn btn--ghost" href="#rezultate">Vezi rezultatele</a>
      </div>
    </div>
  </section>

  <!-- Parteneri -->
  <section class="partners" aria-labelledby="partners-h">
    <div class="wrap">
      <h2 class="eyebrow partners__h" id="partners-h">Parteneri &amp; certificări</h2>
      <LogoWall items={partners} variant="row" label="Parteneri și certificări" links />
    </div>
  </section>

  <!-- Studii de caz -->
  <section class="section cases" id="rezultate" aria-labelledby="cases-h">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">Studii de caz</p>
        <h2 class="h2" id="cases-h">Cum am generat, concret, <em>rezultate</em> pentru clienții DAR Media.</h2>
        <a class="more sec-aside" href="/studii-de-caz/">Toate cele {caseStudies.length} studii de caz <Arrow /></a>
      </div>
    </div>
    <div class="cases__scroller">
      <ul class="wrap cases__grid">
        {cases.map((c, i) => <li data-reveal style={`--d:${(i % 2) * 80}ms`}><CaseCard c={c} /></li>)}
      </ul>
    </div>
  </section>

  <!-- Ce facem -->
  <section class="section manifest on-dark" aria-labelledby="man-h">
    <div class="wrap">
      <div class="manifest__top">
        <div>
          <p class="eyebrow">Ce facem</p>
          <h2 class="h2" id="man-h">Darul tău, <em>darul</em> nostru.</h2>
        </div>
        <dl class="gifts">
          <div><dt>Darul tău</dt><dd>O afacere cu potențial de creștere, care livrează produse și servicii excelente.</dd></div>
          <div><dt>Darul nostru</dt><dd>Strategii de omnichannel marketing care îți aduc leaduri și vânzări profitabile.</dd></div>
        </dl>
      </div>
      <ol class="pillars">
        {keyResults.map((k, i) => (
          <li class="card" data-reveal style={`--d:${i * 70}ms`}>
            <span class="icon-badge"><Icon name={pillarIcon[i]} /></span>
            <h3 class="h3">{k.title}</h3>
            <p class="muted">{k.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Servicii -->
  <section class="section services" id="servicii" aria-labelledby="svc-h">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">Servicii</p>
        <h2 class="h2" id="svc-h">Crește-ți afacerea cu servicii de marketing digital, focusate pe <em>rezultate</em> concrete.</h2>
        <a class="more sec-aside" href="/servicii/">Toate serviciile <Arrow /></a>
      </div>
      <ServiceList />
    </div>
  </section>

  <!-- Cifre -->
  <section class="section numbers on-dark" aria-labelledby="num-h">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">Numerele vorbesc</p>
        <h2 class="h2" id="num-h">Suntem mereu pregătiți pentru o <em>nouă</em> provocare.</h2>
      </div>
      <dl class="numbers__list">
        {proof.map((s, i) => (
          <div class="card" data-reveal style={`--d:${i * 80}ms`}>
            <dt class="numbers__label">{s.label}</dt>
            <dd class="numbers__val">{s.value}{s.unit && <small>{s.unit}</small>}</dd>
            <dd class="numbers__note">{s.note}</dd>
          </div>
        ))}
      </dl>
      <p class="numbers__g">
        <span class="stars" aria-hidden="true">{[0, 1, 2, 3, 4].map(() => <Icon name="star" class="icon star" />)}</span>
        <span><strong>{googleReviews.rating}</strong> pe Google, pe baza a {googleReviews.count} de recenzii.</span>
        <a class="link" href="/portofoliu/#recenzii">Citește recenziile</a>
      </p>
    </div>
  </section>

  <Testimonials />

  <!-- Echipa -->
  <section class="section team on-dark" aria-labelledby="team-h">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">Despre noi</p>
        <h2 class="h2" id="team-h">Echipa ta creativă de marketing, care îți aduce <em>rezultate</em> măsurate.</h2>
        <a class="more sec-aside" href="/echipa-darmedia/">Vezi echipa <Arrow /></a>
      </div>
      <div class="team__feature">
        <figure class="team__photo" data-reveal>
          <Picture src={fondatori} formats={['avif', 'webp']} fallbackFormat="webp" widths={[480, 800, 1200, 1600]} sizes="(max-width: 900px) 100vw, 58vw" alt="Dumitru, Adelina și Radu, fondatorii DAR Media, cu mâinile unite" loading="lazy" decoding="async" />
          <figcaption><span><b>D</b>umitru, <b>A</b>delina &amp; <b>R</b>adu</span><span>Fondatorii DAR Media</span></figcaption>
        </figure>
        <div class="team__note" data-reveal style="--d:100ms">
          <p class="team__lead">Numele a apărut de la inițialele prenumelor noastre — Dumitru, Adelina, Radu — și de la ideea că orice om și orice business are un dar prețios de oferit celorlalți.</p>
          <p class="muted">Credem cu tărie în forța echipei noastre, formată din colegi tineri, creativi și orientați spre rezultate. Atuurile noastre sunt comunicarea, transparența, evoluția continuă și relațiile solide construite între noi.</p>
          <a class="more" href="/povestea-noastra/">Povestea noastră <Arrow /></a>
        </div>
      </div>
      <ul class="team__grid">
        {founders.map((f, i) => (
          <li class="card" data-reveal style={`--d:${i * 90}ms`}>
            <div class="team__pic">
              <span class="team__letter" aria-hidden="true">{f.initial}</span>
              <Picture src={portraits[f.name]} formats={['avif', 'webp']} fallbackFormat="webp" widths={[240, 450]} sizes="(max-width: 640px) 50vw, 300px" alt={f.name} loading="lazy" decoding="async" />
            </div>
            <div class="team__cap">
              <h3 class="h4">{f.name}</h3>
              <p class="muted small">{f.role}</p>
              <a class="team__in" href={f.links.LinkedIn} target="_blank" rel="noopener noreferrer">LinkedIn<span class="sr-only"> — {f.name} (se deschide într-o filă nouă)</span></a>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Clienți -->
  <section class="section clients" aria-labelledby="cl-h">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">Au încredere în noi</p>
        <h2 class="h2" id="cl-h">Afaceri care au ales <em>DAR Media.</em></h2>
        <a class="more sec-aside" href="/portofoliu/">Portofoliu · {clients.length} branduri <Arrow /></a>
      </div>
      <LogoWall items={clients} variant="marquee" label={`Logourile celor ${clients.length} de clienți DAR Media`} />
    </div>
  </section>

  <!-- FAQ -->
  <section class="section faqs on-dark" aria-labelledby="faq-h">
    <div class="wrap faqs__in">
      <div class="faqs__head">
        <p class="eyebrow">Întrebări frecvente</p>
        <h2 class="h2" id="faq-h">Răspunsuri <em>directe,</em> înainte de primul call.</h2>
        <p class="muted">Nu ai găsit răspunsul? <a class="link" href="/contact/">Scrie-ne</a> sau <a class="link" href={company.calendly} target="_blank" rel="noopener noreferrer">programează o discuție</a>.</p>
      </div>
      <div class="faqs__list"><Faq items={faq} /></div>
    </div>
  </section>

  <!-- Resurse -->
  <section class="section learn" aria-labelledby="learn-h">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">Învață să te promovezi mai eficient, la un cost mai mic</p>
        <h2 class="h2" id="learn-h">Afacerea ta crește prin educație continuă de marketing &amp; <em>business.</em></h2>
      </div>
      <div class="learn__grid">
        <ul class="learn__links">
          <li><a class="card card--link" href="/ebook/"><span class="h4">Ebook-uri gratuite</span><Arrow /></a></li>
          <li><a class="card card--link" href="/blog/"><span class="h4">Blog</span><Arrow /></a></li>
          <li><a class="card card--link" href={company.social[3].href} target="_blank" rel="noopener noreferrer"><span class="h4">Video<span class="sr-only"> (YouTube, se deschide într-o filă nouă)</span></span><Arrow dir="up-right" /></a></li>
        </ul>
        <ul class="learn__posts">
          {latest.map((p) => (
            <li>
              <a href={`/${p.slug}/`} class="card card--link">
                {p.cover && <img src={p.cover.src} width={p.cover.width} height={p.cover.height} srcset={coverSrcset(p.cover)} sizes="(max-width: 640px) 120px, 300px" alt="" loading="lazy" decoding="async" />}
                <span class="learn__body">
                  <span class="tag">{p.categories[0]} · {formatDate(p.date)}</span>
                  <span class="learn__title">{p.title}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <Cta />
</Base>

<style>
  /* hero */
  .hero { position: relative; overflow: hidden; isolation: isolate; border-bottom: 1px solid var(--line); background:
      radial-gradient(60% 70% at 85% 10%, rgba(237, 30, 121, 0.26), transparent 70%),
      radial-gradient(50% 60% at 0% 100%, rgba(158, 0, 93, 0.28), transparent 70%),
      var(--bg); }
  .hero::after { content: ''; position: absolute; inset: 0; z-index: -1; background-image: linear-gradient(var(--line) 1px, transparent 1px), linear-gradient(90deg, var(--line) 1px, transparent 1px); background-size: 72px 72px; -webkit-mask-image: radial-gradient(80% 70% at 60% 30%, #000, transparent 75%); mask-image: radial-gradient(80% 70% at 60% 30%, #000, transparent 75%); opacity: 0.45; }
  .hero__bg { position: absolute; z-index: -1; right: -12rem; top: 50%; transform: translateY(-50%); width: min(62vw, 56rem); pointer-events: none; }
  .hero__bg :global(.hero__mark) { width: 100%; height: auto; color: var(--accent); opacity: 0.07; }
  .hero__in { display: grid; gap: clamp(1.25rem, 2.5vw, 1.75rem); justify-items: start; padding-block: clamp(3.5rem, 10vw, 8.5rem) clamp(3.5rem, 8vw, 6.5rem); min-height: min(88svh, 52rem); align-content: center; }
  .hero__title { max-width: 17ch; }
  .hero__sub { max-width: 36rem; }
  .hero__proof { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.25rem; }
  .hero__proof li { display: inline-flex; align-items: baseline; gap: 0.4rem; padding: 0.45rem 0.95rem; border: 1px solid var(--line-2); border-radius: var(--r-pill); background: rgba(255, 255, 255, 0.03); color: var(--text-2); font-size: var(--fs-sm); }
  .hero__proof strong { color: var(--text); font-weight: 800; font-size: 1.0625rem; letter-spacing: -0.02em; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 0.75rem; }

  /* partners */
  .partners { padding-block: clamp(2rem, 4vw, 3rem); border-bottom: 1px solid var(--line); }
  .partners__h { margin-bottom: 1.5rem; }

  /* cases */
  .cases__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--gap); }
  .cases__grid > li { display: flex; }
  .cases__grid > li > :global(a) { flex: 1; }
  @media (max-width: 760px) {
    .cases__scroller { overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; overscroll-behavior-x: contain; }
    .cases__scroller::-webkit-scrollbar { display: none; }
    .cases__grid { display: flex; width: max-content; max-width: none; gap: 0.75rem; padding-bottom: 0.5rem; }
    .cases__grid > li { width: min(84vw, 22rem); scroll-snap-align: start; scroll-margin-left: var(--gutter); }
  }

  /* manifest */
  .manifest__top { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 2rem var(--gap); align-items: end; margin-bottom: clamp(2.25rem, 4.5vw, 3.5rem); }
  .manifest__top > div { grid-column: 1 / span 5; display: grid; gap: 1.25rem; }
  .gifts { grid-column: 7 / -1; display: grid; grid-template-columns: 1fr 1fr; gap: var(--gap); }
  .gifts > div { padding-top: 1rem; border-top: 2px solid var(--accent); display: grid; gap: 0.5rem; align-content: start; }
  .gifts dt { font-size: var(--fs-xs); font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent-text); }
  .gifts dd { font-size: var(--fs-lg); line-height: 1.4; text-wrap: pretty; }
  .pillars { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--gap); }
  .pillars li { padding: clamp(1.25rem, 2.2vw, 1.75rem); display: grid; gap: 0.85rem; align-content: start; }
  .pillars .h3 { margin-top: 0.5rem; }

  /* numbers */
  .numbers__list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--gap); }
  .numbers__list > div { padding: clamp(1.5rem, 3vw, 2.25rem); display: grid; gap: 0.75rem; align-content: start; }
  .numbers__label { order: -1; font-size: var(--fs-xs); font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-2); }
  .numbers__val { font-size: var(--fs-mega); font-weight: 800; line-height: 0.95; letter-spacing: -0.055em; }
  .numbers__val small { font-size: 0.32em; letter-spacing: -0.01em; margin-left: 0.3em; color: var(--accent-text); font-weight: 750; }
  .numbers__note { color: var(--text-2); font-size: var(--fs-sm); }
  .numbers__g { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1rem; margin-top: 1.5rem; color: var(--text-2); }
  .numbers__g strong { color: var(--text); }
  .stars { display: inline-flex; gap: 0.15rem; color: #f5b400; }
  .stars :global(.star) { width: 1.1rem; height: 1.1rem; fill: currentColor; }

  /* team */
  .team__feature { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 2rem var(--gap); align-items: end; margin-bottom: var(--gap); }
  .team__photo { grid-column: 1 / span 7; }
  .team__photo :global(img) { width: 100%; height: auto; aspect-ratio: 1600 / 1093; object-fit: cover; border-radius: var(--r-lg); border: 1px solid var(--line); }
  .team__photo figcaption { display: flex; justify-content: space-between; gap: 1rem; margin-top: 0.75rem; font-size: var(--fs-sm); color: var(--text-2); }
  .team__photo b { color: var(--accent-text); }
  .team__note { grid-column: 9 / -1; display: grid; gap: 1.25rem; justify-items: start; }
  .team__lead { font-size: var(--fs-h4); font-weight: 600; line-height: 1.4; letter-spacing: -0.015em; }
  .team__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--gap); }
  .team__grid > li { overflow: hidden; }
  .team__pic { position: relative; aspect-ratio: 1; display: grid; place-items: end center; overflow: hidden; background: radial-gradient(70% 70% at 50% 60%, rgba(237, 30, 121, 0.22), transparent 70%); border-bottom: 1px solid var(--line); }
  .team__letter { position: absolute; left: 50%; top: 45%; transform: translate(-50%, -50%); font-size: clamp(9rem, 22vw, 18rem); font-weight: 800; line-height: 0.7; letter-spacing: -0.06em; color: rgba(255, 255, 255, 0.05); }
  .team__pic :global(img) { position: relative; width: 88%; height: auto; transition: transform 0.6s var(--ease); }
  .team__grid li:hover .team__pic :global(img) { transform: translateY(-0.35rem); }
  .team__cap { display: grid; grid-template-columns: 1fr auto; gap: 0.15rem 1rem; align-items: center; padding: 1.1rem 1.25rem 1.25rem; }
  .team__cap .muted { grid-column: 1; }
  .team__in { grid-column: 2; grid-row: 1 / span 2; display: inline-flex; align-items: center; min-height: 2.75rem; padding: 0 0.9rem; border: 1px solid var(--line-2); border-radius: var(--r-pill); font-size: var(--fs-sm); font-weight: 700; }
  .team__in:hover { border-color: var(--accent); color: var(--accent-text); }

  /* faq */
  .faqs__in { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 2rem var(--gap); }
  .faqs__head { grid-column: 1 / span 4; display: grid; gap: 1.25rem; align-content: start; position: sticky; top: calc(var(--header-h) + 2rem); align-self: start; }
  .faqs__list { grid-column: 6 / -1; }

  /* learn */
  .learn__grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: var(--gap); }
  .learn__links { grid-column: 1 / span 4; display: grid; gap: 0.6rem; align-content: start; }
  .learn__links a { display: flex; justify-content: space-between; align-items: center; min-height: 4.5rem; padding: 0 1.25rem; }
  .learn__links :global(.arrow) { color: var(--accent-text); }
  .learn__posts { grid-column: 5 / -1; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--gap); }
  .learn__posts a { display: grid; grid-template-rows: auto 1fr; overflow: hidden; height: 100%; }
  .learn__posts img { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; background: var(--surface-2); }
  .learn__body { display: grid; gap: 0.6rem; align-content: start; padding: 1.1rem 1.25rem 1.4rem; }
  .learn__title { font-size: 1.125rem; font-weight: 650; line-height: 1.3; letter-spacing: -0.015em; }

  @media (max-width: 1040px) {
    .pillars { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .learn__links, .learn__posts { grid-column: 1 / -1; }
    .learn__links { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 900px) {
    .manifest__top > div, .gifts, .team__photo, .team__note, .faqs__head, .faqs__list { grid-column: 1 / -1; position: static; }
    .numbers__list { grid-template-columns: 1fr; }
    .team__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .hero__bg { right: -55%; width: 120vw; top: 18%; }
    .gifts { grid-template-columns: 1fr; }
    .pillars { grid-template-columns: 1fr; }
    .team__grid { grid-template-columns: 1fr; }
    .team__pic { aspect-ratio: 1; }
    .team__pic :global(img) { width: 96%; }
    .learn__links { grid-template-columns: 1fr; }
    .learn__posts { grid-template-columns: 1fr; }
    .learn__posts a { grid-template-columns: 7.5rem 1fr; grid-template-rows: auto; }
    .learn__posts img { height: 100%; aspect-ratio: auto; }
    .learn__body { padding: 0.9rem 1rem; }
  }
</style>
