---
// Acordeon accesibil nativ (details/summary): funcționează cu tastatura și cititoarele de ecran fără JS.
import type { Faq } from '../data/site';
interface Props { items: Faq[] }
const { items } = Astro.props;
---
<div class="faq">
  {items.map((f) => (
    <details>
      <summary><span>{f.q}</span><i aria-hidden="true"></i></summary>
      <div class="faq__a" set:html={f.a} />
    </details>
  ))}
</div>
<style>
  .faq { display: grid; gap: 0.6rem; }
  details { background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-md); transition: border-color var(--dur) var(--ease), background-color var(--dur) var(--ease); }
  details[open] { border-color: var(--line-2); background: var(--surface-2); }
  summary { display: flex; justify-content: space-between; align-items: center; gap: 1.25rem; min-height: 3.75rem; padding: 0.9rem 1.25rem; cursor: pointer; list-style: none; font-size: var(--fs-h4); font-weight: 650; letter-spacing: -0.015em; line-height: 1.3; border-radius: var(--r-md); }
  summary::-webkit-details-marker { display: none; }
  summary:hover { color: var(--accent-text); }
  summary i { position: relative; flex: none; width: 2rem; height: 2rem; border-radius: 50%; border: 1px solid var(--line-2); color: var(--text); }
  summary i::before, summary i::after { content: ''; position: absolute; left: 50%; top: 50%; width: 0.75rem; height: 1.5px; background: currentColor; transform: translate(-50%, -50%); transition: transform var(--dur) var(--ease); }
  summary i::after { transform: translate(-50%, -50%) rotate(90deg); }
  details[open] summary i { border-color: var(--accent); color: var(--accent-text); }
  details[open] summary i::after { transform: translate(-50%, -50%) rotate(0deg); }
  .faq__a { padding: 0 1.25rem 1.4rem; max-width: 46rem; color: var(--text-2); }
  .faq__a :global(p + p), .faq__a :global(p + ul), .faq__a :global(ul + p), .faq__a :global(p + ol) { margin-top: 0.8rem; }
  .faq__a :global(ul), .faq__a :global(ol) { padding-left: 1.2rem; }
  .faq__a :global(ul) { list-style: disc; }
  .faq__a :global(ol) { list-style: decimal; }
  .faq__a :global(li) { margin-top: 0.3rem; }
  .faq__a :global(li::marker) { color: var(--accent-text); }
  .faq__a :global(strong) { color: var(--text); font-weight: 700; }
  .faq__a :global(a) { color: var(--accent-text); text-decoration: underline; text-underline-offset: 0.2em; }
</style>
