---
import { testimonials } from '../data/site';
interface Props { title?: string }
const { title = 'Ce spun <em>clienții</em> noștri' } = Astro.props;
---
<section class="section tst t-cream" data-theme="cream" aria-labelledby="tst-h">
  <div class="wrap">
    <div class="tst__head">
      <p class="eyebrow">Testimoniale</p>
      <h2 class="h2" id="tst-h" set:html={title} />
    </div>
    <div class="tst__body" data-tst>
      <div class="tst__tabs" role="tablist" aria-label="Clienți">
        {testimonials.map((t, i) => (
          <button role="tab" type="button" id={`tst-tab-${i}`} aria-controls={`tst-panel-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
            <span class="num">{String(i + 1).padStart(2, '0')}</span><span>{t.short}</span>
          </button>
        ))}
      </div>
      <div class="tst__panels">
        {testimonials.map((t, i) => (
          <div role="tabpanel" class="tst__panel" id={`tst-panel-${i}`} aria-labelledby={`tst-tab-${i}`} hidden={i !== 0} tabindex="0"><figure>
            <blockquote>
              <p class="tst__first">{t.quote[0]}</p>
              {t.quote.slice(1).map((q) => <p class="tst__rest">{q}</p>)}
            </blockquote>
            <figcaption><strong>{t.name}</strong><span>{t.role}</span></figcaption>
          </figure></div>
        ))}
      </div>
    </div>
  </div>
</section>
<style>
  .tst { overflow: hidden; }
  .tst__head { display: grid; gap: 1.25rem; margin-bottom: clamp(2rem, 4.5vw, 3.5rem); }
  .tst__body { position: relative; isolation: isolate; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 2rem var(--gap); align-items: start; }
  .tst__body::before { content: '„'; position: absolute; z-index: -1; left: 22%; top: -0.55em; font-family: var(--serif); font-style: italic; font-size: clamp(14rem, 30vw, 30rem); line-height: 1; color: var(--pink-2); pointer-events: none; }
  .tst__tabs { grid-column: 1 / span 3; display: grid; border-top: 2px solid var(--fg); position: sticky; top: calc(var(--header-h) + 2rem); }
  .tst__tabs button { display: flex; align-items: center; gap: 0.9rem; min-height: 3.25rem; padding: 0; background: none; border: 0; border-bottom: 1px solid var(--line-2); text-align: left; cursor: pointer; font-size: 1.0625rem; font-weight: 650; color: var(--fg-2); transition: color var(--dur), transform 0.4s var(--ease-out); }
  .tst__tabs button:hover { color: var(--fg); transform: translateX(0.35rem); }
  .tst__tabs button[aria-selected='true'] { color: var(--fg); font-weight: 800; transform: translateX(0.6rem); }
  .tst__tabs button[aria-selected='true'] .num { color: var(--accent-text); }
  .tst__tabs .num { color: var(--fg-2); }
  .tst__panels { grid-column: 5 / -1; }
  .tst__first { font-size: clamp(1.5rem, 1.1rem + 1.6vw, 2.5rem); font-weight: 750; line-height: 1.2; letter-spacing: -0.035em; text-wrap: pretty; max-width: 44rem; }
  .tst__rest { margin-top: 1.1rem; max-width: 42rem; color: var(--fg-2); font-size: var(--fs-lg); }
  figcaption { display: flex; flex-wrap: wrap; gap: 0.25rem 0.75rem; align-items: baseline; margin-top: 2rem; padding-top: 1rem; border-top: 2px solid var(--fg); max-width: 42rem; }
  figcaption strong { font-size: var(--fs-lg); }
  figcaption span { color: var(--fg-2); }
  .js .tst__panel:not([hidden]) { animation: tst-in 0.6s var(--ease-out); }
  @keyframes tst-in { from { opacity: 0; transform: translateY(1rem); } }
  @media (max-width: 900px) {
    .tst__body::before { left: auto; right: -2rem; top: -6rem; }
    .tst__tabs { grid-column: 1 / -1; position: static; display: flex; overflow-x: auto; gap: 1.25rem; border-top: 0; border-bottom: 1px solid var(--line-2); scrollbar-width: none; margin-inline: calc(var(--gutter) * -1); padding-inline: var(--gutter); }
    .tst__tabs button { flex: none; border-bottom: 3px solid transparent; transform: none !important; font-size: 0.9375rem; min-height: 2.75rem; }
    .tst__tabs button .num { display: none; }
    .tst__tabs button[aria-selected='true'] { border-bottom-color: var(--magenta); }
    .tst__panels { grid-column: 1 / -1; }
  }
</style>
<script>
  document.querySelectorAll<HTMLElement>('[data-tst]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role=tab]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[role=tabpanel]')];
    const select = (i: number, focus = false) => {
      tabs.forEach((t, j) => { t.setAttribute('aria-selected', String(i === j)); t.tabIndex = i === j ? 0 : -1; });
      panels.forEach((p, j) => (p.hidden = i !== j));
      if (focus) tabs[i].focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(i));
      t.addEventListener('keydown', (e) => {
        if (['ArrowDown', 'ArrowRight'].includes(e.key)) { e.preventDefault(); select((i + 1) % tabs.length, true); }
        if (['ArrowUp', 'ArrowLeft'].includes(e.key)) { e.preventDefault(); select((i - 1 + tabs.length) % tabs.length, true); }
      });
    });
  });
</script>
