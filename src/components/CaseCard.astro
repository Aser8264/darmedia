---
// Studiu de caz ca rând editorial: cifra (cu unitatea la aceeași linie de bază), rezultatul, canalul, link.
import Arrow from './Arrow.astro';
import { logoSize } from '../data/logos';
import type { CaseStudy } from '../data/site';
interface Props { c: CaseStudy; i?: number; title?: string; date?: string; headingLevel?: 'h3' | 'h2' }
const { c, title, date, headingLevel: H = 'h3' } = Astro.props;
---
<a href={`/${c.slug}/`} class="cc">
  <span class="cc__fig">
    <span class="cc__num">{c.figure}</span>{c.unit && ' '}{c.unit && <span class="cc__unit">{c.unit}</span>}
  </span>
  <span class="cc__body">
    <H class="cc__line">{c.line}</H>
    <span class="cc__meta">
      <span>{c.channel}</span>
      {c.logo && <img class="cc__logo" src={`/media/logos/${c.logo}.webp`} alt={c.client ?? ''} width={logoSize[c.logo].w} height={logoSize[c.logo].h} loading="lazy" decoding="async" />}
      {title && <span class="cc__title">{title}{date && <> · {date}</>}</span>}
    </span>
    <span class="cc__more">Citește studiul de caz <Arrow /></span>
  </span>
</a>
<style>
  .cc { display: grid; gap: 0.9rem; padding-block: 1.75rem 2rem; border-top: 1px solid var(--line-2); height: 100%; color: var(--fg); }
  .cc__fig { display: block; line-height: 1; font-variant-numeric: lining-nums; }
  .cc__num { font-size: clamp(2.75rem, 2rem + 3vw, 4.25rem); font-weight: 700; line-height: 1; letter-spacing: -0.035em; }
  .cc__unit { font-size: clamp(1.25rem, 1rem + 0.8vw, 1.6rem); font-weight: 650; letter-spacing: 0; margin-left: 0.3em; color: var(--accent-text); }
  .cc__body { display: grid; gap: 0.6rem; justify-items: start; }
  .cc__line { font-size: var(--fs-lg); font-weight: 500; line-height: 1.45; max-width: 30em; text-wrap: pretty; letter-spacing: -0.005em; }
  .cc__meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.35rem 1rem; font-size: var(--fs-sm); color: var(--fg-2); }
  .cc__logo { max-height: 1.75rem; width: auto; filter: brightness(0); opacity: 0.7; }
  .cc__title { flex-basis: 100%; }
  .cc__more { display: inline-flex; align-items: center; gap: 0.45rem; min-height: 2.5rem; font-weight: 650; font-size: var(--fs-sm); }
  .cc__more :global(.arrow) { color: var(--accent-text); transition: transform 0.2s var(--ease-out); }
  @media (hover: hover) and (pointer: fine) {
    .cc { transition: border-color 0.2s ease; }
    .cc:hover { border-top-color: var(--magenta); }
    .cc:hover .cc__more { color: var(--accent-text); }
    .cc:hover .cc__more :global(.arrow) { transform: translateX(3px); }
  }
</style>
