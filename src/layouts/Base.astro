---
// Fonturi self-hosted (subseturi latin + latin-ext din @fontsource), font-display: swap. Preîncărcăm doar greutatea variabilă Hanken (latin) — critică pentru titluri.
import hankenLatin from '@fontsource-variable/hanken-grotesk/files/hanken-grotesk-latin-wght-normal.woff2?url';
import hankenLatinExt from '@fontsource-variable/hanken-grotesk/files/hanken-grotesk-latin-ext-wght-normal.woff2?url';
import serifLatin from '@fontsource/instrument-serif/files/instrument-serif-latin-400-italic.woff2?url';
import serifLatinExt from '@fontsource/instrument-serif/files/instrument-serif-latin-ext-400-italic.woff2?url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyCta from '../components/StickyCta.astro';
import Intro from '../components/Intro.astro';
import { company } from '../data/site';

interface Props { title: string; description?: string; image?: string; imageAlt?: string; article?: boolean; noindex?: boolean; intro?: boolean; colorShift?: boolean }
const {
  title,
  description = 'DAR Media — agenție de digital marketing din Cluj-Napoca. Strategii de omnichannel marketing care îți aduc leaduri și vânzări profitabile.',
  image = '/media/site/fondatori.webp',
  imageAlt = 'Dumitru, Adelina și Radu, fondatorii DAR Media',
  article = false,
  noindex = false,
  intro = false,
  colorShift = false,
} = Astro.props;
const fullTitle = title.includes('DAR Media') ? title : `${title} — DAR Media`;
const SITE = 'https://darmedia.ro'; // canonicalul e mereu domeniul real, indiferent unde e găzduit build-ul
const canonical = new URL(Astro.url.pathname, SITE).href;
const ogImage = new URL(image, SITE).href;

const LATIN = 'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const LATIN_EXT = 'U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF';
const fontCss = `
@font-face{font-family:'Hanken Grotesk Variable';font-style:normal;font-display:swap;font-weight:100 900;src:url(${hankenLatin}) format('woff2');unicode-range:${LATIN}}
@font-face{font-family:'Hanken Grotesk Variable';font-style:normal;font-display:swap;font-weight:100 900;src:url(${hankenLatinExt}) format('woff2');unicode-range:${LATIN_EXT}}
@font-face{font-family:'Instrument Serif';font-style:italic;font-display:swap;font-weight:400;src:url(${serifLatin}) format('woff2');unicode-range:${LATIN}}
@font-face{font-family:'Instrument Serif';font-style:italic;font-display:swap;font-weight:400;src:url(${serifLatinExt}) format('woff2');unicode-range:${LATIN_EXT}}
@font-face{font-family:'Hanken Fallback';src:local('Arial'),local('Helvetica'),local('Roboto');size-adjust:93%;ascent-override:107%;descent-override:32%;line-gap-override:0%}`;

// Date structurate — doar informații reale de pe site.
const orgId = `${SITE}/#organization`;
const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization', '@id': orgId, name: company.name, alternateName: 'DAR Media Marketing', legalName: company.legalName,
      url: `${SITE}/`, logo: `${SITE}/favicon.svg`, email: company.email, telephone: '+40736702107', foundingDate: String(company.since),
      vatID: company.cui, sameAs: company.social.map((s) => s.href),
      address: { '@type': 'PostalAddress', streetAddress: company.hq.line, addressLocality: company.hq.city, addressRegion: 'Cluj', addressCountry: 'RO' },
    },
    {
      '@type': 'LocalBusiness', '@id': `${SITE}/#localbusiness`, name: company.name, parentOrganization: { '@id': orgId },
      url: `${SITE}/`, image: `${SITE}/media/site/fondatori.webp`, email: company.email, telephone: '+40736702107',
      address: { '@type': 'PostalAddress', streetAddress: company.office.line, addressLocality: 'Florești', addressRegion: 'Cluj', addressCountry: 'RO' },
      areaServed: 'RO', sameAs: company.social.map((s) => s.href),
    },
    { '@type': 'WebSite', '@id': `${SITE}/#website`, url: `${SITE}/`, name: company.name, inLanguage: 'ro-RO', publisher: { '@id': orgId } },
  ],
};
---
<!doctype html>
<html lang="ro">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="preload" href={hankenLatin} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={fontCss}></style>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" hreflang="ro" href={canonical} />
    <link rel="alternate" hreflang="en" href={company.english} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#f4efe8" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:locale" content="ro_RO" />
    <meta property="og:site_name" content="DAR Media" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    <script is:inline data-show-intro={intro ? '1' : '0'}>
      // Intro la fiecare încărcare a paginii principale; sărit la prefers-reduced-motion. Fără JS, intro-ul se închide singur din CSS.
      (function () {
        var d = document.documentElement; d.classList.add('js');
        var skip = matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!document.currentScript || document.currentScript.dataset.showIntro !== '1') skip = true;
        d.classList.add(skip ? 'no-intro' : 'has-intro');
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    {intro && <Intro />}
    <a class="skip" href="#main">Sari la conținut</a>
    <Header />
    <main id="main" tabindex="-1"><slot /></main>
    <Footer />
    <StickyCta />
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
