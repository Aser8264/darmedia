---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Testimonials from '../components/Testimonials.astro';
import Cta from '../components/Cta.astro';
import Arrow from '../components/Arrow.astro';
import CaseCard from '../components/CaseCard.astro';
import LogoWall from '../components/LogoWall.astro';
import Icon from '../components/Icon.astro';
import { clients, googleReviews, caseStudies } from '../data/site';
import { postBySlug } from '../data/posts';
const cases = caseStudies.filter((c) => c.featured && postBySlug(c.slug)).slice(0, 3);
---
<Base title="Portofoliu" description="Branduri care au ales DAR Media: magazine online, business-uri de servicii, HoReCa și nu numai.">
  <PageHero eyebrow="Portofoliu" title="Afaceri care au ales <em>DAR Media.</em>" lead="DAR Media sprijină afacerile aflate în faza de creștere & scalare să genereze vânzări profitabile, clienți mulțumiți și impact pe termen lung." crumbs={[{ label: 'Portofoliu' }]} />
  <section class="section pf" aria-labelledby="pf-h">
    <div class="wrap">
      <h2 class="sr-only" id="pf-h">Clienți DAR Media</h2>
      <LogoWall items={clients} variant="grid" label={`${clients.length} de clienți DAR Media`} links captions />
    </div>
  </section>
  <section class="section pf-cases on-dark" aria-labelledby="pfc-h">
    <div class="wrap">
      <div class="sec-head"><p class="eyebrow">Rezultate</p><h2 class="h2" id="pfc-h">Câteva cifre din <em>studiile</em> de caz.</h2><a class="more sec-aside" href="/studii-de-caz/">Toate studiile de caz <Arrow /></a></div>
      <ul class="pf-cases__grid">{cases.map((c) => <li><CaseCard c={c} /></li>)}</ul>
    </div>
  </section>
  <Testimonials />
  <section class="section rv on-dark" id="recenzii" aria-labelledby="rv-h">
    <div class="wrap">
      <div class="sec-head"><p class="eyebrow">Recenzii Google</p><h2 class="h2" id="rv-h"><em>{googleReviews.rating}</em> — pe baza a {googleReviews.count} de recenzii.</h2></div>
      <ul class="rv__list">
        {googleReviews.items.map((r) => (
          <li class="card">
            <span class="rv__stars" aria-hidden="true">{[0, 1, 2, 3, 4].map(() => <Icon name="star" class="icon" />)}</span>
            <blockquote>{r.text}</blockquote>
            <p><strong>{r.name}</strong><span class="muted"> · {r.role}</span></p>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <Cta />
</Base>
<style>
  .pf-cases__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--gap); }
  .pf-cases__grid > li { display: flex; }
  .pf-cases__grid > li > :global(a) { flex: 1; }
  .rv__list { columns: 2; column-gap: var(--gap); }
  .rv__list li { break-inside: avoid; display: grid; gap: 1rem; padding: clamp(1.25rem, 2.5vw, 1.75rem); margin-bottom: var(--gap); }
  .rv__stars { display: inline-flex; gap: 0.15rem; color: #f5b400; }
  .rv__stars :global(.icon) { width: 1rem; height: 1rem; fill: currentColor; }
  .rv__list blockquote { margin: 0; font-size: 1.0625rem; line-height: 1.6; }
  .rv__list p { font-size: var(--fs-sm); }
  @media (max-width: 900px) { .pf-cases__grid { grid-template-columns: 1fr; } .rv__list { columns: 1; } }
</style>
