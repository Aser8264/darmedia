---
// CTA persistent: bară jos pe mobil (apare după hero, dispare în footer) + buton WhatsApp flotant pe desktop.
import Arrow from './Arrow.astro';
import { company } from '../data/site';
const wa = company.whatsapp ? `https://wa.me/${company.whatsapp}` : null;
const waIcon = '<path d="M12 2.2A9.8 9.8 0 0 0 3.6 17l-1.4 5 5.2-1.4A9.8 9.8 0 1 0 12 2.2Zm0 17.9a8.1 8.1 0 0 1-4.1-1.1l-.3-.2-3.1.8.8-3-.2-.3A8.1 8.1 0 1 1 12 20.1Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.6 6.6 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 11.9 11.9 0 0 0 4.6 4c1.7.7 2.3.8 3.2.7.5-.1 1.5-.6 1.8-1.2.2-.6.2-1.1.1-1.2l-.5-.3Z"/>';
---
<div class="sticky" data-sticky>
  <a href="/audit-gratuit/" class="btn sticky__cta">Cere un audit gratuit <Arrow /></a>
  {wa && (
    <a href={wa} class="sticky__wa" target="_blank" rel="noopener noreferrer">
      <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor" aria-hidden="true" set:html={waIcon} />
      <span class="sr-only">Scrie-ne pe WhatsApp (se deschide într-o filă nouă)</span>
    </a>
  )}
</div>
<style>
  .sticky { position: fixed; z-index: 30; left: 0; right: 0; bottom: 0; display: flex; gap: 0.6rem; padding: 0.75rem var(--gutter) calc(0.75rem + env(safe-area-inset-bottom)); background: rgba(244, 239, 232, 0.96); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); border-top: 1px solid var(--line); transform: translateY(110%); transition: transform 0.4s var(--ease); }
  .sticky.is-on { transform: none; }
  .sticky__cta { flex: 1; }
  .sticky__wa { flex: none; display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; background: #1f9d55; color: #fff; transition: transform var(--dur) var(--ease); }
  .sticky__wa:hover { transform: scale(1.06); }
  @media (min-width: 769px) {
    .sticky { left: auto; right: 1.5rem; bottom: 1.5rem; padding: 0; background: none; border: 0; -webkit-backdrop-filter: none; backdrop-filter: none; transform: none; }
    .sticky__cta { display: none; }
    .sticky__wa { box-shadow: var(--shadow-2); transition: transform var(--dur) var(--ease), opacity var(--dur) var(--ease); }
    /* ascuns în hero și în footer, ca să nu acopere insignele ANPC */
    .sticky:not(.is-on) .sticky__wa { opacity: 0; transform: scale(0.6); pointer-events: none; visibility: hidden; }
    .sticky:not(.has-wa) { display: none; }
  }
</style>
<script>
  const bar = document.querySelector<HTMLElement>('[data-sticky]');
  if (bar) {
    if (bar.querySelector('.sticky__wa')) bar.classList.add('has-wa');
    const hero = document.querySelector('[data-hero]');
    const footer = document.querySelector('[data-footer]');
    let pastHero = !hero && window.scrollY > 400;
    let inFooter = false;
    const update = () => bar.classList.toggle('is-on', pastHero && !inFooter);
    if ('IntersectionObserver' in window) {
      if (hero) new IntersectionObserver(([e]) => { pastHero = !e.isIntersecting; update(); }).observe(hero);
      else window.addEventListener('scroll', () => { pastHero = window.scrollY > 400; update(); }, { passive: true });
      if (footer) new IntersectionObserver(([e]) => { inFooter = e.isIntersecting; update(); }).observe(footer);
    }
    update();
  }
</script>
