---
// Acordeon accesibil nativ (details/summary): funcționează cu tastatura și cititoarele de ecran fără JS.
import type { Faq } from '../data/site';
interface Props { items: Faq[] }
const { items } = Astro.props;
---
<div class="faq">
  {items.map((f) => (
    <details>
      <summary><span>{f.q}</span><i aria-hidden="true"></i></summary>
      <div class="faq__a" set:html={f.a} />
    </details>
  ))}
</div>
<style>
  .faq { border-top: 1px solid var(--line-2); }
  details { border-bottom: 1px solid var(--line); }
  summary { display: grid; grid-template-columns: 1fr 2rem; align-items: center; gap: 1rem; min-height: 4rem; padding-block: 0.9rem; cursor: pointer; list-style: none; font-size: var(--fs-h4); font-weight: 600; letter-spacing: -0.015em; line-height: 1.3; }
  summary::-webkit-details-marker { display: none; }
  summary i { position: relative; justify-self: end; width: 2rem; height: 2rem; border: 1px solid var(--line-2); border-radius: 50%; transition: transform 0.25s var(--ease-out), border-color 0.15s ease; }
  summary i::before, summary i::after { content: ''; position: absolute; left: 50%; top: 50%; width: 0.7rem; height: 1.5px; background: currentColor; transform: translate(-50%, -50%); }
  summary i::after { transform: translate(-50%, -50%) rotate(90deg); }
  details[open] summary i { transform: rotate(45deg); border-color: var(--magenta); color: var(--mark); }
  @media (hover: hover) and (pointer: fine) { summary:hover { color: var(--accent-text); } }
  .faq__a { padding: 0 3rem 1.5rem 0; max-width: 46rem; color: var(--fg-2); }
  @supports selector(::details-content) {
    @media (prefers-reduced-motion: no-preference) {
      .faq { interpolate-size: allow-keywords; }
      details::details-content { block-size: 0; overflow: clip; transition: block-size 0.3s var(--ease-out), content-visibility 0.3s allow-discrete; }
      details[open]::details-content { block-size: auto; }
    }
  }
  .faq__a :global(p + p), .faq__a :global(p + ul), .faq__a :global(ul + p), .faq__a :global(p + ol) { margin-top: 0.8rem; }
  .faq__a :global(ul), .faq__a :global(ol) { padding-left: 1.2rem; }
  .faq__a :global(ul) { list-style: disc; }
  .faq__a :global(ol) { list-style: decimal; }
  .faq__a :global(li) { margin-top: 0.3rem; }
  .faq__a :global(li::marker) { color: var(--magenta); }
  .faq__a :global(strong) { color: var(--fg); font-weight: 650; }
  .faq__a :global(a) { color: var(--accent-text); text-decoration: underline; text-underline-offset: 0.2em; }
  @media (max-width: 640px) { .faq__a { padding-right: 0; } }
</style>
