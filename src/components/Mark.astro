---
import { markPath } from '../data/mark';
interface Props { size?: number; class?: string; title?: string; outline?: boolean }
const { size = 32, class: cls, title, outline = false } = Astro.props;
---
<svg class={cls} width={size} height={size} viewBox="0 0 300 300" fill={outline ? 'none' : 'currentColor'} stroke={outline ? 'currentColor' : undefined} stroke-width={outline ? 2 : undefined} vector-effect={outline ? 'non-scaling-stroke' : undefined} role={title ? 'img' : undefined} aria-label={title} aria-hidden={title ? undefined : 'true'}>
  <path fill-rule="evenodd" d={markPath} vector-effect={outline ? 'non-scaling-stroke' : undefined} />
</svg>
